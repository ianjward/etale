# Calendar dates in the Gregorian calendar, as in "2026-10-15".

Year {Integer} (0..9999)
Month {Integer} (1..12)
Day_Of_Month {Integer} (1..31)
Years_Per_Leap {Integer} (4)
Years_Per_Century {Integer} (100)
Years_Per_Cycle {Integer} (400)

# One rule of the calendar: when its divisor divides the year, this is the answer.
Leap_Rule {}
  divisor* {Integer} (1..)
  is_leap* {True | False}

# The rules in the order they are tried. The rule of 1 divides every year.
Every_400 {Leap_Rule} (Years_Per_Cycle, True)
Every_100 {Leap_Rule} (Years_Per_Century, False)
Every_4 {Leap_Rule} (Years_Per_Leap, True)
Every_Year {Leap_Rule} (1, False)
Gregorian_Rules {Leap_Rule...} (Every_400, Every_100, Every_4, Every_Year)

# One rule tried on a year: whether its divisor divides the year.
# Example: the rule of 4 on 2026 leaves 2, so it does not.
Rule_Try {}
  year* {Year}
  rule* {Leap_Rule}
  remainder {Integer} (year) wrap_at: rule.divisor
  is_divisible {True | False} (remainder)
    {True} (0)
    {False} (1..)

# The rule that decides a year: the first rule whose divisor divides it.
# Example: 1900: 400 does not divide it, 100 does, so it is not a leap year.
Leap_Year {}
  year* {Year}
  rules* {Leap_Rule...} count: 1..
  tries {Rule_Try...} (year, rules...)                  # one try for each rule, in order
  dividing {Rule_Try...} (tries.is_divisible = True)
  deciding {Rule_Try} (dividing.first)
  result {Leap_Rule} (deciding.rule)

# How many days a month has. February has 29 in a leap year.
# Example: month 2 in a leap year has 29 days; month 4 has 30.
Month_Length {}
  month* {Month}
  is_leap* {True | False}
  days {Day_Of_Month} (month, is_leap)
    {31} (month in 1 | 3 | 5 | 7 | 8 | 10 | 12)
    {30} (month in 4 | 6 | 9 | 11)
    {29} (month = 2 & is_leap = True)
    {28} (month = 2 & is_leap = False)

Date {}
  year {Year}
  month {Month}
  day {Day_Of_Month}
  leap_year {Leap_Year} (year, Gregorian_Rules)
  month_length {Month_Length} (month, leap_year.is_leap)
  real_date {Needs} (day <= month_length.days)
  text {Text}
    1. {year} digits: 4
    2. {"-"}
    3. {month} digits: 2
    4. {"-"}
    5. {day} digits: 2
