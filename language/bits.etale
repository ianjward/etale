# Bits, binary numbers and bytes.

Bit {Integer} (0..1)                     # a bit as a number, as a remainder of halving

# Binary digits, highest first, as in "101". Empty_String is the one with no digits.
Binary_String {Binary_Digit...} count: 0..

# A byte: eight binary digits, highest first. "01000001" is 65.
Byte {Binary_Digit...} count: 8

Base {Integer} (2)                       # binary: each place is two of the place below
Zero_Digit {"0"}

# One division: how many times the divisor fits, and what is left.
# Example: 5 divided by 2 is 2, and 1 is left.
Division {}
  number* {Integer} (0..)
  divisor* {Integer} (1..)
  remainder {Integer} (number) wrap_at: divisor
  multiple_of {Integer} (number - remainder)       # the part the divisor fits into
  quotient {Integer} (multiple_of / divisor)

# A bit as a binary digit: 1 is "1".
Bit_Digit {}
  bit* {Bit}
  result {Binary_Digit} (bit)
    {"0"} (0)
    {"1"} (1)

# Writing a number in binary by dividing by 2 again and again: each
# remainder goes in front of the digits so far, until the quotient is 0.
# Example: 5 with no digits gives "1", then "01", then "101".
Integer_To_Binary {}
  number* {Integer} (0..)
  digits_so_far* {Binary_String}
  division {Division} (number, Base)
  digit {Bit_Digit} (division.remainder)
  digits {Binary_String} (digit, digits_so_far...)
  result {Binary_String} (digits)
    while (division.quotient >= 1)
    next (division.quotient, digits)

# Binary digits with zeros in front.
# Example: "101" with 4 zeros to add gives "0000101".
Leading_Zeros {}
  digits* {Binary_String}
  zeros_to_add* {Integer} (0..)
  padded {Binary_String} (Zero_Digit, digits...)
  zeros_left {Integer} (zeros_to_add - 1)
  result {Binary_String} (digits)
    while (zeros_to_add >= 1)
    next (padded, zeros_left)
