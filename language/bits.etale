# Bits, binary numbers and bytes.

Bit {Integer} (0..1)                     # a bit as a number. wasm.etale uses it.

# A binary number: its digits, highest first, as in "101".
Binary_Number {Binary_Digit...} count: 1..

# A byte: eight binary digits, highest first. "01000001" is 65.
Byte {Binary_Digit...} count: 8

# The value of each place of a byte. wasm.etale uses them until it is rewritten.
Place_7 {Integer} (128)
Place_6 {Integer} (64)
Place_5 {Integer} (32)
Place_4 {Integer} (16)
Place_3 {Integer} (8)
Place_2 {Integer} (4)
Place_1 {Integer} (2)
