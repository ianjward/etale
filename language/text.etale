# Common text shapes.

# A word of letters.
Letter {Uppercase | Lowercase}
Word {Letter...} count: 1..

# The part of an email address before '@': a letter, then letters, digits or '_'.
Mailbox_Name {Text}
  1. {Lowercase}
  2. {Lower_Name_Character...}

# A domain name: labels joined by dots, as in "mail.example".
Domain_Character {Lowercase | Digit | "-"}
Domain_Label {Domain_Character...} count: 1..63

Later_Label {Text}                       # ".example": a dot, then a label
  1. {"."}
  2. {Domain_Label}

Domain_Name {Text}
  1. {Domain_Label}
  2. {Later_Label...} count: 1..

# An email address, as in "ana@mail.example".
Email_Address {Text}
  1. {Mailbox_Name}
  2. {"@"}
  3. {Domain_Name}

# One line of text, and a paragraph of lines.
Text_Line {}
  characters {Line_Text}
  text {Text}
    1. {characters}
    2. {Newline}

Paragraph {}
  lines {Text_Line...} count: 1..
  line_count {Integer} (lines.count)
