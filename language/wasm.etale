# WebAssembly from the kernel: each Compiled type reads kernel text, and makes its Wasm record.

Number_Size {Integer} (5)                # the bytes of a number: always five, as WebAssembly allows
Locals_And_End {Integer} (4)             # three bytes for the locals, one for the end
Helper_Code_Size {Integer} (113)         # read, write and _start
Helper_Count {Integer} (3)               # read, write and _start, before the program's functions
First_Program_Function {Integer} (6)     # three imports and three helpers come first
Half_Of_U32 {Integer} (2147483648)
All_Of_U32 {Integer} (4294967296)

# A U32 read as WebAssembly reads an i32: from 2147483648 up, the same
# 32 bits stand for that number less 4294967296.
# Example: 5 is 5, and 4294967295 is -1.
U32_To_I32 {}
  amount* {U32}
  moved_up {Integer} (amount + Half_Of_U32) wrap_at: All_Of_U32
  result {Integer} (moved_up - Half_Of_U32)

Compiled_Word {Value_Word | Block_Word | Break_Word | Call_Word | Return_Word | Byte_Word}

Group_Width {Integer} (7)                # WebAssembly writes a number seven bits to a byte

# A number from 0 to 127 as seven binary digits.
# Example: 5 gives "0000101".
Seven_Bit_Group {}
  number* {Integer} (0..127)
  binary {Integer_To_Binary} (number, Empty_String)
  zeros_to_add {Integer} (Group_Width - binary.count)
  result {Leading_Zeros} (binary, zeros_to_add)

Group_Values {Integer} (128)             # the numbers seven bits can hold
Number_Values {Integer} (Group_Values * Group_Values * Group_Values * Group_Values * Group_Values)

# One byte of a number as WebAssembly writes it: "1" when another byte
# follows, "0" on the last, then seven bits of the number.
Wasm_Byte {}
  more_follows* {Binary_Digit}
  bits* {Binary_String} count: 7

# A number as WebAssembly writes it here: five bytes, lowest first.
Wasm_Number {}
  bytes* {Wasm_Byte...} count: 5

# Writing a number in bytes by dividing by 128 again and again: each
# remainder is the seven bits of the next byte, until no bytes are left.
# Example: 300 in two bytes gives "1" "0101100", then "0" "0000010".
Integer_To_Wasm_Bytes {}
  number* {Integer} (0..)
  bytes_left* {Integer} (1..)
  bytes_so_far* {Wasm_Byte...}
  division {Division} (number, Group_Values)
  bits {Seven_Bit_Group} (division.remainder)
  more_follows {Binary_Digit} (bytes_left)
    {"0"} (1)
    {"1"} (2..)
  byte {Wasm_Byte} (more_follows, bits)
  bytes {Wasm_Byte...} (bytes_so_far..., byte)
  bytes_after {Integer} (bytes_left - 1)
  result {Wasm_Byte...} (bytes)
    while (bytes_left >= 2)
    next (division.quotient, bytes_after, bytes)

# A number of 0 or more as WebAssembly writes it here.
# Example: 5 gives "1" "0000101", then "1" "0000000" three times, then "0" "0000000".
Integer_To_Wasm_Number {}
  number* {Integer} (0..)
  bytes {Integer_To_Wasm_Bytes} (number, Number_Size, Empty_String)
  result {Wasm_Number} (bytes)

Head_Size {Integer} (1..3)               # the bytes of a head

# What WebAssembly writes first for a word, and how many bytes that is.
# Each kind of word has its own head; a word makes the head that takes it.

Push_Opcode {"01000001"}                 # i32.const
Drop_Opcode {"00011010"}
Get_Opcode {"00100000"}                  # local.get
Set_Opcode {"00100001"}                  # local.set
Stack_Opcodes {Push_Opcode | Drop_Opcode | Get_Opcode | Set_Opcode}

Stack_Head {}                            # put on, throw away, or move a value
  word* {Push_Word | Stack_Word | Local_Word}
  bits {Stack_Opcodes} (word)
    {Push_Opcode} ("push")
    {Drop_Opcode} ("drop")
    {Get_Opcode} ("get")
    {Set_Opcode} ("set")
  size {Head_Size} (word)
    {1} (Push_Word | Stack_Word | Local_Word)

Add_Opcode {"01101010"}                  # i32.add
Subtract_Opcode {"01101011"}             # i32.sub
Multiply_Opcode {"01101100"}             # i32.mul
Divide_Opcode {"01101110"}               # i32.div_u
Remainder_Opcode {"01110000"}            # i32.rem_u
Division_Opcodes {Divide_Opcode | Remainder_Opcode}
Arithmetic_Opcodes {Add_Opcode | Subtract_Opcode | Multiply_Opcode | Division_Opcodes}

Arithmetic_Head {}
  word* {Arithmetic_Word}
  bits {Arithmetic_Opcodes} (word)
    {Add_Opcode} ("add")
    {Subtract_Opcode} ("subtract")
    {Multiply_Opcode} ("multiply")
    {Divide_Opcode} ("divide")
    {Remainder_Opcode} ("remainder")
  size {Head_Size} (word)
    {1} (Arithmetic_Word)

Less_Opcode {"01001001"}                 # i32.lt_u
Equal_Opcode {"01000110"}                # i32.eq
Compare_Opcodes {Less_Opcode | Equal_Opcode}

Compare_Head {}
  word* {Compare_Word}
  bits {Compare_Opcodes} (word)
    {Less_Opcode} ("less")
    {Equal_Opcode} ("equal")
  size {Head_Size} (word)
    {1} (Compare_Word)

Load_Byte_Opcode {"001011010000000000000000"}   # i32.load8_u, aligned to 1, offset 0
Store_Byte_Opcode {"001110100000000000000000"}  # i32.store8, aligned to 1, offset 0
Load_Opcode {"001010000000001000000000"}        # i32.load, aligned to 4, offset 0
Store_Opcode {"001101100000001000000000"}       # i32.store, aligned to 4, offset 0
Memory_Opcodes {Load_Byte_Opcode | Store_Byte_Opcode | Load_Opcode | Store_Opcode}

Memory_Head {}                           # the opcode, its alignment and its offset
  word* {Memory_Word}
  bits {Memory_Opcodes} (word)
    {Load_Byte_Opcode} ("load_byte")
    {Store_Byte_Opcode} ("store_byte")
    {Load_Opcode} ("load")
    {Store_Opcode} ("store")
  size {Head_Size} (word)
    {3} (Memory_Word)

Block_Opcode {"0000001001000000"}        # block, giving nothing
Loop_Opcode {"0000001101000000"}         # loop, giving nothing
End_Opcode {"00001011"}
Block_Opcodes {Block_Opcode | Loop_Opcode | End_Opcode}

Block_Head {}                            # a block or a loop also says what it gives
  word* {Block_Word}
  bits {Block_Opcodes} (word)
    {Block_Opcode} ("block")
    {Loop_Opcode} ("loop")
    {End_Opcode} ("end")
  size {Head_Size} (word)
    {2} ("block" | "loop")
    {1} ("end")

Break_Opcode {"00001100"}                # br
Break_If_Opcode {"00001101"}             # br_if
Return_Opcode {"00001111"}
Break_Opcodes {Break_Opcode | Break_If_Opcode | Return_Opcode}

Break_Head {}                            # leave blocks, or the function
  word* {Break_Word | Return_Word}
  bits {Break_Opcodes} (word)
    {Break_Opcode} ("break")
    {Break_If_Opcode} ("break_if")
    {Return_Opcode} ("return")
  size {Head_Size} (word)
    {1} (Break_Word | Return_Word)

Read_Call {"0001000000000011"}           # call function 3, read
Write_Call {"0001000000000100"}          # call function 4, write
Byte_Calls {Read_Call | Write_Call}

Byte_Head {}                             # a call to read or write, the helpers 3 and 4
  word* {Byte_Word}
  bits {Byte_Calls} (word)
    {Read_Call} ("read")
    {Write_Call} ("write")
  size {Head_Size} (word)
    {2} (Byte_Word)

Call_Opcode {"00010000"}                 # call, then the function's number

Call_Head {}                             # run a function of the program
  word* {Call_Word}
  bits {Call_Opcode} (word)
    {Call_Opcode} ("call")
  size {Head_Size} (word)
    {1} (Call_Word)

Value_Head {Stack_Head | Arithmetic_Head | Compare_Head | Memory_Head}
Control_Head {Block_Head | Break_Head | Call_Head | Byte_Head}
Word_Head {Value_Head | Control_Head}

Value_Opcodes {Stack_Opcodes | Arithmetic_Opcodes | Compare_Opcodes | Memory_Opcodes}
Instruction_Head {Value_Opcodes | Block_Opcodes | Break_Opcodes | Call_Opcode | Byte_Calls}

# An instruction as WebAssembly writes it.
Wasm_Instruction {}
  head* {Instruction_Head}
  number* {Wasm_Number} count: 0..1
  text {Binary_Digit}
    1. {head}
    2. {number}

# A function as WebAssembly writes it: the size of its body, its four
# i32 locals, its code and its end.
Wasm_Function {}
  body_length* {Wasm_Number}
  code* {Wasm_Instruction...}
  text {Binary_Digit}
    1. {body_length}
    2. {"00000001"}                      # one group of locals
    3. {"00000100"}                      # of four locals
    4. {"01111111"}                      # each an i32
    5. {code}
    6. {"00001011"}                      # the end of the function

Wasm_Type {Integer} (0..6)               # a function's type, in the types section

# The functions section: its size, the count of functions, and the type of each: read,
# write and _start, then the functions of the program.
Wasm_Function_Section {}
  length* {Wasm_Number}
  function_count* {Wasm_Number}
  types* {Wasm_Number...}
  text {Binary_Digit}
    1. {"00000011"}                      # section 3
    2. {length}
    3. {function_count}
    4. {"00000000"}                      # function 3, read: type 0
    5. {"00000001"}                      # function 4, write: type 1
    6. {"00000011"}                      # function 5, _start: type 3
    7. {types}                           # function 6 and on: type 0

# The code section: its size, the count of functions, read, write and _start, then the
# functions of the program.
Wasm_Code_Section {}
  length* {Wasm_Number}
  function_count* {Wasm_Number}
  functions* {Wasm_Function...} count: 1..
  text {Binary_Digit}
    1. {"00001010"}                      # section 10
    2. {length}
    3. {function_count}
    4. {"00111010"}                      # function read, 58 bytes:
    5. {"00000000"}                      # no locals
    6. {"01000001111100001111111100000011"}  # i32.const 65520
    7. {"01000001111111001111111100000011"}  # i32.const 65532
    8. {"001101100000001000000000"}      # i32.store
    9. {"01000001111101001111111100000011"}  # i32.const 65524
    10. {"0100000100000001"}             # i32.const 1
    11. {"001101100000001000000000"}     # i32.store
    12. {"0100000100000000"}             # i32.const 0
    13. {"01000001111100001111111100000011"}  # i32.const 65520
    14. {"0100000100000001"}             # i32.const 1
    15. {"01000001111110001111111100000011"}  # i32.const 65528
    16. {"0001000000000000"}             # call fd_read
    17. {"00011010"}                     # drop
    18. {"01000001111110001111111100000011"}  # i32.const 65528
    19. {"001010000000001000000000"}     # i32.load
    20. {"01000101"}                     # i32.eqz: no byte was read
    21. {"0000010001111111"}             # if, giving an i32
    22. {"0100000101111111"}             # i32.const -1
    23. {"00000101"}                     # else
    24. {"01000001111111001111111100000011"}  # i32.const 65532
    25. {"001011010000000000000000"}     # i32.load8_u
    26. {"00001011"}                     # end
    27. {"00001011"}                     # end
    28. {"00101110"}                     # function write, 46 bytes:
    29. {"00000000"}                     # no locals
    30. {"01000001111111001111111100000011"}  # i32.const 65532
    31. {"0010000000000000"}             # local.get 0: the byte
    32. {"001110100000000000000000"}     # i32.store8
    33. {"01000001111100001111111100000011"}  # i32.const 65520
    34. {"01000001111111001111111100000011"}  # i32.const 65532
    35. {"001101100000001000000000"}     # i32.store
    36. {"01000001111101001111111100000011"}  # i32.const 65524
    37. {"0100000100000001"}             # i32.const 1
    38. {"001101100000001000000000"}     # i32.store
    39. {"0100000100000001"}             # i32.const 1
    40. {"01000001111100001111111100000011"}  # i32.const 65520
    41. {"0100000100000001"}             # i32.const 1
    42. {"01000001111110001111111100000011"}  # i32.const 65528
    43. {"0001000000000001"}             # call fd_write
    44. {"00011010"}                     # drop
    45. {"00001011"}                     # end
    46. {"00000110"}                     # function _start, 6 bytes:
    47. {"00000000"}                     # no locals
    48. {"0001000000000110"}             # call main
    49. {"0001000000000010"}             # call proc_exit
    50. {"00001011"}                     # end
    51. {functions}

# A module as WebAssembly writes it, with the functions of a program.
Wasm_Program {}
  function_section* {Wasm_Function_Section}
  code_section* {Wasm_Code_Section}
  text {Binary_Digit}
    1. {"00000000011000010111001101101101"}
    2. {"00000001000000000000000000000000"}  # version 1
    3. {"0000000100100110"}              # the types: section 1, 38 bytes
    4. {"00000111"}                      # seven types:
    5. {"01100000000000000000000101111111"}  # type 0: takes nothing, gives an i32
    6. {"01100000000000010111111100000000"}  # type 1: takes an i32, gives nothing
    7. {"01100000000001000111111101111111011111110111111100000001"}
    8. {"01111111"}                      # and so on
    9. {"011000000000000000000000"}      # type 3: takes nothing, gives nothing
    10. {"0110000000000001011111110000000101111111"}  # type 4: takes an i32, gives an i32
    11. {"011000000000001001111111011111110000000101111111"}  # type 5: takes two
    12. {"01100000000000110111111101111111011111110000000101111111"}  # type 6: takes three
    13. {"0000001001100111"}             # the imports: section 2, 103 bytes
    14. {"00000011"}                     # three imports:
    15. {"00010110011101110110000101110011011010010101111101110011"}
    16. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    17. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    18. {"01110111001100010000011101100110011001000101111101110010"}  # "w1fd_r"
    19. {"0110010101100001011001000000000000000010"}  # "ead"
    20. {"00010110011101110110000101110011011010010101111101110011"}
    21. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    22. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    23. {"01110111001100010000100001100110011001000101111101110111"}  # "w1fd_w"
    24. {"011100100110100101110100011001010000000000000010"}  # "rite"
    25. {"00010110011101110110000101110011011010010101111101110011"}
    26. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    27. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    28. {"01110111001100010000100101110000011100100110111101100011"}  # "w1proc"
    29. {"01011111011001010111100001101001011101000000000000000001"}  # "_exit"
    30. {function_section}
    31. {"0000010100000011"}             # the memory: section 5, 3 bytes
    32. {"000000010000000000000001"}     # one memory, of at least one page
    33. {"0000011100011010"}             # the exports: section 7, 26 bytes
    34. {"00000011"}                     # three exports:
    35. {"00000110011011010110010101101101011011110111001001111001"}  # "memory": memory 0
    36. {"0000001000000000"}             # and so on
    37. {"00000110010111110111001101110100011000010111001001110100"}  # "_start": function 5
    38. {"0000000000000101"}             # and so on
    39. {"00000100011011010110000101101001011011100000000000000110"}  # "main": function 6
    40. {code_section}

Compiled_Number {}                       # " 5", in "push 5"
  amount {U32}
  signed {U32_To_I32} (amount)
  number_written {Integer} (signed) wrap_at: Number_Values     # the same bits, but never below 0
  written {Integer_To_Wasm_Number} (number_written)
  text {Text}
    1. {" "}
    2. {amount}

Compiled_Function_Number {}              # " 1", in "call 1"
  function {U32}
  index {Integer} (function + First_Program_Function)
  written {Integer_To_Wasm_Number} (index)
  text {Text}
    1. {" "}
    2. {function}

Compiled_Instruction {}                  # "  push 5"
  word {Compiled_Word}
  numbers {Compiled_Number...} count: 0..1
  functions {Compiled_Function_Number...} count: 0..1
  arguments {Word_Arguments} (word)
  right_numbers {Needs} (numbers.count = arguments.numbers)
  right_functions {Needs} (functions.count = arguments.functions)
  head {Word_Head} (word)
  number_values {Wasm_Number...} (numbers.written)
  function_values {Wasm_Number...} (functions.written)
  written {Wasm_Number...} (number_values..., function_values...)
  argument_count {Integer} (arguments.numbers + arguments.functions)
  number_bytes {Integer} (argument_count * Number_Size)
  size {Integer} (head.size + number_bytes)
  wasm {Wasm_Instruction} (head.bits, written)
  text {Text}
    1. {"  "}
    2. {word}
    3. {numbers}
    4. {functions}
    5. {Newline}

Compiled_Function {}                     # "function 0 main takes 0", then its instructions
  number {U32}
  name {Kernel_Name}
  inputs {Input_Count}
  instructions {Compiled_Instruction...} count: 1..
  type_number {Wasm_Type} (inputs)         # the type for the values it takes
    {0} (0)
    {4} (1)
    {5} (2)
    {6} (3)
  type {Integer_To_Wasm_Number} (type_number)
  sizes {Integer...} (instructions.size)
  code_size {Integer} (sizes.sum)
  body_size {Integer} (code_size + Locals_And_End)
  size {Integer} (Number_Size + body_size)
  length {Integer_To_Wasm_Number} (body_size)
  code {Wasm_Instruction...} (instructions.wasm)
  wasm {Wasm_Function} (length, code)
  text {Text}
    1. {"function "}
    2. {number}
    3. {" "}
    4. {name}
    5. {" takes "}
    6. {inputs}
    7. {Newline}
    8. {instructions}

# The functions section for a program's functions: a type for each, after read, write and _start.
# Example: main and one other function give a count of 5 and two types of 0.
Functions_To_Wasm_Section {}
  functions* {Compiled_Function...}
  all_functions {Integer} (functions.count + Helper_Count)
  function_count {Integer_To_Wasm_Number} (all_functions)
  types {Wasm_Number...} (functions.type)
  type_bytes {Integer} (functions.count * Number_Size)
  types_size {Integer} (Number_Size + Helper_Count + type_bytes)
  types_length {Integer_To_Wasm_Number} (types_size)
  result {Wasm_Function_Section} (types_length, function_count, types)

# The code section for a program's functions: its size, the count of functions, read, write and
# _start, then the code of each function.
# Example: main alone, with a count of 4, gives read, write, _start and main.
Functions_To_Wasm_Code {}
  functions* {Compiled_Function...}
  function_count* {Wasm_Number}
  function_sizes {Integer...} (functions.size)
  function_bytes {Integer} (function_sizes.sum)
  section_size {Integer} (function_bytes + Number_Size + Helper_Code_Size)
  section_length {Integer_To_Wasm_Number} (section_size)
  compiled {Wasm_Function...} (functions.wasm)
  result {Wasm_Code_Section} (section_length, function_count, compiled)

# A program's functions are numbered 0, 1, 2 and on, main first, as the kernel says. In
# WebAssembly they come after the three imports and three helpers.
Compiled_Program {}
  functions {Compiled_Function...} count: 1.., order: number, unique: number
  first_function {Compiled_Function} (functions.first)
  last_function {Compiled_Function} (functions.last)
  last_number {Integer} (functions.count - 1)
  main_is_0 {Needs} (first_function.number = 0 & first_function.name = "main")
  main_takes_nothing {Needs} (first_function.inputs = 0)
  no_gaps {Needs} (last_function.number = last_number)
  mains {Compiled_Function...} (functions.name = "main")
  one_main {Needs} (mains.count = 1)
  instructions {Compiled_Instruction...} (functions.instructions)
  calls {Compiled_Instruction...} (instructions.word = "call")
  called_functions {Compiled_Function_Number...} (calls.functions)
  calls_are_known {Needs} (called_functions.function in functions.number)
  function_section {Functions_To_Wasm_Section} (functions)
  code_section {Functions_To_Wasm_Code} (functions, function_section.function_count)
  wasm {Wasm_Program} (function_section, code_section)
