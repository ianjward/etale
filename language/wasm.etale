# WebAssembly from the kernel. Each Compiled type reads a kernel text, as
# kernel.etale writes it, and makes the Wasm record of the same part: a
# record that stores its bits. Every Wasm type's shape is 'text
# {Binary_Digit}', so the bits read back to the same record. To compile:
#
#   node engine/etale.mjs print language/wasm.etale Compiled_Program FILE wasm
#
# This compiler takes a program of one function, main, and every word
# but call. A call needs the number of its function in WebAssembly.
#
# The program runs on WASI, the standard way for WebAssembly to reach
# its input and output. Every module has three functions besides main:
# read and write, which call WASI for one byte, and _start, which runs
# main and ends the program with main's value. read and write keep their
# work in the last 16 bytes of memory, from 65520.
#
# WebAssembly writes a number in one to five bytes, seven bits of the
# number in each. This compiler always writes five, which WebAssembly
# allows. So a number's size is known, and nothing here recurses.
#
# A kernel number is a U32. WebAssembly writes the number of i32.const,
# the opcode of push, as a signed number: from -2147483648 to
# 2147483647. So a number of 2147483648 or more is written as that
# number less 4294967296: the same 32 bits. Every other number here is
# below 2147483648, where the two forms are the same.

Number_Size {Integer} (5)                # the bytes of a number, always five
Locals_And_End {Integer} (4)             # three bytes for the locals, one for the end
Helper_Code_Size {Integer} (114)         # the count of functions, and read, write and _start
Half_Of_U32 {Integer} (2147483648)
All_Of_U32 {Integer} (4294967296)

# The words that this compiler takes.
Compiled_Word {Value_Word | Block_Word | Break_Word | Return_Word | Byte_Word}

Group_Width {Integer} (7)                # WebAssembly writes a number seven bits to a byte

# A number from 0 to 127 as seven binary digits.
# Example: 5 gives "0000101".
Seven_Bit_Group {}
  number* {Integer} (0..127)
  binary {Integer_To_Binary} (number, Empty_String)
  zeros_to_add {Integer} (Group_Width - binary.count)
  result {Leading_Zeros} (binary, zeros_to_add)

# A number as WebAssembly writes it here: five bytes of seven bits each,
# lowest first. The top bit of a byte is 1 when another byte follows.
Wasm_Number {}
  first {Binary_String} count: 7
  second {Binary_String} count: 7
  third {Binary_String} count: 7
  fourth {Binary_String} count: 7
  fifth {Binary_String} count: 7
  text {Binary_Digit}
    1. {"1"}
    2. {first}
    3. {"1"}
    4. {second}
    5. {"1"}
    6. {third}
    7. {"1"}
    8. {fourth}
    9. {"0"}
    10. {fifth}

# A number in five parts of seven bits, lowest first, and the Wasm_Number
# they make. A wrap keeps each part from 0 to 127, below 0 too.
Number_Parts {}
  number {Integer}
  first_part {Integer} (number) wrap_at: Place_7
  less_first {Integer} (number - first_part)
  after_first {Integer} (less_first / Place_7)
  second_part {Integer} (after_first) wrap_at: Place_7
  less_second {Integer} (after_first - second_part)
  after_second {Integer} (less_second / Place_7)
  third_part {Integer} (after_second) wrap_at: Place_7
  less_third {Integer} (after_second - third_part)
  after_third {Integer} (less_third / Place_7)
  fourth_part {Integer} (after_third) wrap_at: Place_7
  less_fourth {Integer} (after_third - fourth_part)
  after_fourth {Integer} (less_fourth / Place_7)
  fifth_part {Integer} (after_fourth) wrap_at: Place_7
  first {Seven_Bit_Group} (first_part)
  second {Seven_Bit_Group} (second_part)
  third {Seven_Bit_Group} (third_part)
  fourth {Seven_Bit_Group} (fourth_part)
  fifth {Seven_Bit_Group} (fifth_part)
  written {Wasm_Number}
    1. {first}
    2. {second}
    3. {third}
    4. {fourth}
    5. {fifth}

# What WebAssembly writes for a word: its opcode, then for some opcodes
# the type of a block, the alignment and offset of a memory access, or
# the function that read and write call, 3 or 4.
Value_Head {"01000001" | "00100000" | "00100001" | "00011010"}
Arithmetic_Head {"01101010" | "01101011" | "01101100" | "01101110" | "01110000"}
Compare_Head {"01001001" | "01000110"}
Byte_Memory_Head {"001011010000000000000000" | "001110100000000000000000"}
Word_Memory_Head {"001010000000001000000000" | "001101100000001000000000"}
Block_Head {"0000001001000000" | "0000001101000000" | "00001011"}
Break_Head {"00001100" | "00001101" | "00001111"}
Byte_Head {"0001000000000011" | "0001000000000100"}
Memory_Head {Byte_Memory_Head | Word_Memory_Head}
Control_Head {Block_Head | Break_Head | Byte_Head}
Instruction_Head {Value_Head | Arithmetic_Head | Compare_Head | Memory_Head | Control_Head}
Head_Size {Integer} (1..3)               # the bytes of a head

# An instruction as WebAssembly writes it.
Wasm_Instruction {}
  head {Instruction_Head}
  number {Wasm_Number} count: 0..1
  text {Binary_Digit}
    1. {head}
    2. {number}

# A function as WebAssembly writes it: the size of its body, its four
# i32 locals, its code and its end.
Wasm_Function {}
  body_length {Wasm_Number}
  code {Wasm_Instruction...}
  text {Binary_Digit}
    1. {body_length}
    2. {"00000001"}                      # one group of locals
    3. {"00000100"}                      # of four locals
    4. {"01111111"}                      # each an i32
    5. {code}
    6. {"00001011"}                      # the end of the function

# A module as WebAssembly writes it, with the main function of a program.
Wasm_Program {}
  section_length {Wasm_Number}
  functions {Wasm_Function...} count: 1
  text {Binary_Digit}
    1. {"00000000011000010111001101101101"}
    2. {"00000001000000000000000000000000"}  # version 1
    3. {"0000000100010100"}              # the types: section 1, 20 bytes
    4. {"00000100"}                      # four types:
    5. {"01100000000000000000000101111111"}  # type 0: takes nothing, gives an i32
    6. {"01100000000000010111111100000000"}  # type 1: takes an i32, gives nothing
    7. {"01100000000001000111111101111111011111110111111100000001"}
    8. {"01111111"}                      # and so on
    9. {"011000000000000000000000"}      # type 3: takes nothing, gives nothing
    10. {"0000001001100111"}             # the imports: section 2, 103 bytes
    11. {"00000011"}                     # three imports:
    12. {"00010110011101110110000101110011011010010101111101110011"}
    13. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    14. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    15. {"01110111001100010000011101100110011001000101111101110010"}  # "w1fd_r"
    16. {"0110010101100001011001000000000000000010"}  # "ead"
    17. {"00010110011101110110000101110011011010010101111101110011"}
    18. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    19. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    20. {"01110111001100010000100001100110011001000101111101110111"}  # "w1fd_w"
    21. {"011100100110100101110100011001010000000000000010"}  # "rite"
    22. {"00010110011101110110000101110011011010010101111101110011"}
    23. {"01101110011000010111000001110011011010000110111101110100"}  # "napshot"
    24. {"01011111011100000111001001100101011101100110100101100101"}  # "_previe"
    25. {"01110111001100010000100101110000011100100110111101100011"}  # "w1proc"
    26. {"01011111011001010111100001101001011101000000000000000001"}  # "_exit"
    27. {"0000001100000101"}             # the functions: section 3, 5 bytes
    28. {"00000100"}                     # four functions:
    29. {"00000000"}                     # function 3, read: type 0
    30. {"00000001"}                     # function 4, write: type 1
    31. {"00000011"}                     # function 5, _start: type 3
    32. {"00000000"}                     # function 6, main: type 0
    33. {"0000010100000011"}             # the memory: section 5, 3 bytes
    34. {"000000010000000000000001"}     # one memory, of at least one page
    35. {"0000011100011010"}             # the exports: section 7, 26 bytes
    36. {"00000011"}                     # three exports:
    37. {"00000110011011010110010101101101011011110111001001111001"}  # "memory": memory 0
    38. {"0000001000000000"}             # and so on
    39. {"00000110010111110111001101110100011000010111001001110100"}  # "_start": function 5
    40. {"0000000000000101"}             # and so on
    41. {"00000100011011010110000101101001011011100000000000000110"}  # "main": function 6
    42. {"00001010"}                     # the code: section 10, its size, then four functions
    43. {section_length}
    44. {"00000100"}                     # four functions
    45. {"00111010"}                     # function read, 58 bytes:
    46. {"00000000"}                     # no locals
    47. {"01000001111100001111111100000011"}  # i32.const 65520
    48. {"01000001111111001111111100000011"}  # i32.const 65532
    49. {"001101100000001000000000"}     # i32.store
    50. {"01000001111101001111111100000011"}  # i32.const 65524
    51. {"0100000100000001"}             # i32.const 1
    52. {"001101100000001000000000"}     # i32.store
    53. {"0100000100000000"}             # i32.const 0
    54. {"01000001111100001111111100000011"}  # i32.const 65520
    55. {"0100000100000001"}             # i32.const 1
    56. {"01000001111110001111111100000011"}  # i32.const 65528
    57. {"0001000000000000"}             # call fd_read
    58. {"00011010"}                     # drop
    59. {"01000001111110001111111100000011"}  # i32.const 65528
    60. {"001010000000001000000000"}     # i32.load
    61. {"01000101"}                     # i32.eqz: no byte was read
    62. {"0000010001111111"}             # if, giving an i32
    63. {"0100000101111111"}             # i32.const -1
    64. {"00000101"}                     # else
    65. {"01000001111111001111111100000011"}  # i32.const 65532
    66. {"001011010000000000000000"}     # i32.load8_u
    67. {"00001011"}                     # end
    68. {"00001011"}                     # end
    69. {"00101110"}                     # function write, 46 bytes:
    70. {"00000000"}                     # no locals
    71. {"01000001111111001111111100000011"}  # i32.const 65532
    72. {"0010000000000000"}             # local.get 0: the byte
    73. {"001110100000000000000000"}     # i32.store8
    74. {"01000001111100001111111100000011"}  # i32.const 65520
    75. {"01000001111111001111111100000011"}  # i32.const 65532
    76. {"001101100000001000000000"}     # i32.store
    77. {"01000001111101001111111100000011"}  # i32.const 65524
    78. {"0100000100000001"}             # i32.const 1
    79. {"001101100000001000000000"}     # i32.store
    80. {"0100000100000001"}             # i32.const 1
    81. {"01000001111100001111111100000011"}  # i32.const 65520
    82. {"0100000100000001"}             # i32.const 1
    83. {"01000001111110001111111100000011"}  # i32.const 65528
    84. {"0001000000000001"}             # call fd_write
    85. {"00011010"}                     # drop
    86. {"00001011"}                     # end
    87. {"00000110"}                     # function _start, 6 bytes:
    88. {"00000000"}                     # no locals
    89. {"0001000000000110"}             # call main
    90. {"0001000000000010"}             # call proc_exit
    91. {"00001011"}                     # end
    92. {functions}                        # main

Compiled_Number {}                       # " 5", in "push 5"
  amount {U32}
  moved_up {Integer} (amount + Half_Of_U32) wrap_at: All_Of_U32
  signed {Integer} (moved_up - Half_Of_U32)
  parts {Number_Parts}
    1. {signed}
  text {Text}
    1. {" "}
    2. {amount}

Compiled_Instruction {}                  # "  push 5"
  word {Compiled_Word}
  numbers {Compiled_Number...} count: 0..1
  numbers_needed {Argument_Count} (word)
    {1} (Push_Word | Local_Word | Break_Word)
    {0} (Stack_Word | Arithmetic_Word | Compare_Word | Memory_Word | Block_Word)
    {0} (Return_Word | Byte_Word)
  number_count {Integer} (numbers.count)
  right_numbers {Needs} (number_count = numbers_needed)
  head {Instruction_Head} (word)
    {"01000001"} ("push")
    {"00100000"} ("get")
    {"00100001"} ("set")
    {"00011010"} ("drop")
    {"01101010"} ("add")
    {"01101011"} ("subtract")
    {"01101100"} ("multiply")
    {"01101110"} ("divide")
    {"01110000"} ("remainder")
    {"01001001"} ("less")
    {"01000110"} ("equal")
    {"001011010000000000000000"} ("load_byte")
    {"001110100000000000000000"} ("store_byte")
    {"001010000000001000000000"} ("load")
    {"001101100000001000000000"} ("store")
    {"0000001001000000"} ("block")
    {"0000001101000000"} ("loop")
    {"00001011"} ("end")
    {"00001100"} ("break")
    {"00001101"} ("break_if")
    {"00001111"} ("return")
    {"0001000000000011"} ("read")
    {"0001000000000100"} ("write")
  head_size {Head_Size} (word)
    {1} (Push_Word | Stack_Word | Local_Word | Arithmetic_Word | Compare_Word | "end")
    {1} (Break_Word | Return_Word)
    {2} ("block" | "loop" | Byte_Word)
    {3} (Memory_Word)
  number_parts {Number_Parts...} (numbers.parts)
  written {Wasm_Number...} (number_parts.written)
  number_bytes {Integer} (number_count * Number_Size)
  size {Integer} (head_size + number_bytes)
  wasm {Wasm_Instruction}
    1. {head}
    2. {written}
  text {Text}
    1. {"  "}
    2. {word}
    3. {numbers}
    4. {Newline}

Compiled_Function {}                     # "function main", then its instructions
  name {Kernel_Name}
  instructions {Compiled_Instruction...} count: 1..
  is_main {Needs} (name = "main")
  sizes {Integer...} (instructions.size)
  code_size {Integer} (sizes.sum)
  body_size {Integer} (code_size + Locals_And_End)
  size {Integer} (Number_Size + body_size)
  length_parts {Number_Parts}
    1. {body_size}
  code {Wasm_Instruction...} (instructions.wasm)
  wasm {Wasm_Function}
    1. {length_parts.written}
    2. {code}
  text {Text}
    1. {"function "}
    2. {name}
    3. {Newline}
    4. {instructions}

Compiled_Program {}
  functions {Compiled_Function...} count: 1
  function_sizes {Integer...} (functions.size)
  function_bytes {Integer} (function_sizes.sum)
  section_size {Integer} (function_bytes + Helper_Code_Size)
  section_parts {Number_Parts}
    1. {section_size}
  compiled {Wasm_Function...} (functions.wasm)
  wasm {Wasm_Program}
    1. {section_parts.written}
    2. {compiled}
