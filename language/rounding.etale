# The rounding rules that 'round:' names by its word: none for even, or away, lower, higher.

# Which way a rule moves the value: toward zero, or away from it.
Direction {"toward zero" | "away from zero"}

# Each rule is given the part cut off, as a fraction of the last place kept: 2.5 to 1 cuts 0.5.
Cut_Off {Decimal} (0..1)

# Round half to even, the default: a tie goes to the even neighbour, so 2.5 is 2 and 3.5 is 4.
Half_Even {}
  cut_off* {Cut_Off}
  is_last_digit_odd* {True | False}
  result {Direction} (cut_off, is_last_digit_odd)
    {"toward zero"} (cut_off < 0.5)
    {"away from zero"} (cut_off > 0.5)
    {"toward zero"} (cut_off = 0.5 & is_last_digit_odd = False)
    {"away from zero"} (cut_off = 0.5 & is_last_digit_odd = True)

# Round half away from zero, 'away': 2.5 is 3 and -2.5 is -3.
Half_Away {}
  cut_off* {Cut_Off}
  result {Direction} (cut_off)
    {"toward zero"} (< 0.5)
    {"away from zero"} (>= 0.5)

# Round half toward the lower number, 'lower': 2.5 is 2 and -2.5 is -3.
Half_Lower {}
  cut_off* {Cut_Off}
  is_negative* {True | False}
  result {Direction} (cut_off, is_negative)
    {"toward zero"} (cut_off < 0.5)
    {"away from zero"} (cut_off > 0.5)
    {"toward zero"} (cut_off = 0.5 & is_negative = False)
    {"away from zero"} (cut_off = 0.5 & is_negative = True)

# Round half toward the higher number, 'higher': 2.5 is 3 and -2.5 is -2.
Half_Higher {}
  cut_off* {Cut_Off}
  is_negative* {True | False}
  result {Direction} (cut_off, is_negative)
    {"toward zero"} (cut_off < 0.5)
    {"away from zero"} (cut_off > 0.5)
    {"away from zero"} (cut_off = 0.5 & is_negative = False)
    {"toward zero"} (cut_off = 0.5 & is_negative = True)
