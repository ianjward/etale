# Etale compiled to the kernel: each Compiled type reads Etale text, and makes a kernel Program.

Main_Number {Integer} (0)                # main is function 0
Main_Name {"main"}
No_Inputs {Integer} (0)                  # main takes nothing
One {Integer} (1)

# A program whose main gives one number.
# Example: 7 gives "function 0 main takes 0", then "push 7" and "return".
Number_To_Main {}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  push {Instruction} (Push_Word, arguments, Empty_String)
  give {Instruction} (Return_Word, Empty_String, Empty_String)
  instructions {Instruction...} (push, give)
  head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (head, instructions)
  functions {Function...} (main)
  result {Program} (functions)

# A constant worked out while compiling: its name and its value, which a kernel number holds.
Known_Constant {}
  name* {Type_Name}
  number* {U32}

# A whole number as it is written.
# Example: "7" gives 7.
Literal_Value {}
  written* {Number_Literal}
  known* {Known_Constant...}
  result {Integer} (written)

# A constant's name: the value of the constant of that name, above it.
# Example: "Group_Width", after "Group_Width {Integer} (7)", gives 7.
Name_Value {}
  written* {Path}
  known* {Known_Constant...}
  found {Known_Constant...} (known.name = written)
  constant {Known_Constant} (found.first)
  result {Integer} (constant.number)

# A term is a number or a name.
Term_Value {Literal_Value | Name_Value}

# A product of whole numbers: each number times the product so far.
# Example: 2, 3 and 4 with 1 so far give 24.
Product_Of {}
  numbers* {Integer...}
  so_far* {Integer} (0..)
  number {Integer} (numbers.first)
  product {Integer} (so_far * number)
  result {Integer} (so_far)
    while (numbers.count >= 1)
    next (numbers.rest, product)

# A sum, worked out while compiling.
# Example: "1 + Group_Width" gives 8.
Addition_Value {}
  written* {Sum}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Sum_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first + rest_total)

# A difference: the first term less each of the others.
# Example: "10 - 2 - 3" gives 5.
Subtraction_Value {}
  written* {Difference}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Difference_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first - rest_total)

# A product of terms.
# Example: "2 * 3 * 4" gives 24.
Multiplication_Value {}
  written* {Product}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Product_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  product {Product_Of} (others, first)
  result {Integer} (product)

# A quotient that divides exactly. A divisor of 0, or a remainder, is refused.
# Example: "Group_Values / 2" gives 64.
Division_Value {}
  written* {Quotient}
  known* {Known_Constant...}
  dividend {Term_Value} (written.dividend, known)
  divisor {Term_Value} (written.divisor, known)
  division {Division} (dividend, divisor)
  exact {Needs} (division.remainder = 0)
  result {Integer} (division.quotient)

# A calculation makes the one of these that takes it.
Operation_Value {Addition_Value | Subtraction_Value | Multiplication_Value | Division_Value}
Calculation_Value {Term_Value | Operation_Value}

# The value of the calculation in parentheses.
Parens_Value {}
  parens* {Parens}
  known* {Known_Constant...}
  calculation {Calculation_Value} (parens.content, known)
  result {Integer} (calculation)

# A calculation in parentheses adds a constant: the line's name, and the calculation's value.
# Example: "(Group_Width * 18)" on Group_Values gives Group_Values, 126.
Calculation_Constant {}
  written* {Calculation}
  name* {Type_Name}
  known* {Known_Constant...}
  worked {Calculation_Value} (written, known)
  constant {Known_Constant} (name, worked)
  result {Known_Constant...} (constant)

# Parentheses that hold a range, a choice, conditions or a call add no constant.
# Example: "(0..9)" adds nothing.
No_Constant {}
  written* {Range_Literal | Allowed_Choice | Conditions | Call_Values}
  name* {Type_Name}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Content_Constants {Calculation_Constant | No_Constant}

# A refinement line adds a constant when its parentheses hold a calculation.
# Example: "Group_Width {Integer} (7)" adds Group_Width, 7. "Text {Character...}" adds nothing.
Refinement_Constants {}
  line* {Refinement_Line}
  known* {Known_Constant...}
  written_parens {Parens...} (line.parens)
  contents {Paren_Content...} (written_parens.content)
  found {Content_Constants...} (contents..., line.name, known)
  result {Known_Constant...} (found.result)

# A union line or an intersection line adds no constant.
Other_Line_Constants {}
  line* {Union_Line | Intersection_Line}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Line_Constants {Refinement_Constants | Other_Line_Constants}

# The constants of a group of lines, worked out in order: each may name the ones above it.
# Example: "A {Integer} (2)" then "B {Integer} (A * 3)" give A, 2 and B, 6.
Group_Constants {}
  lines* {Noted_Line...}
  known* {Known_Constant...}
  noted {Noted_Line} (lines.first)
  added {Line_Constants} (noted.line, known)
  with_line {Known_Constant...} (known..., added...)
  result {Known_Constant...} (known)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# A group of one-line declarations adds its constants.
Line_Group_Constants {}
  group* {Line_Group}
  known* {Known_Constant...}
  lines {Noted_Line...} (group.first, group.rest...)
  with_group {Group_Constants} (lines, known)
  result {Known_Constant...} (with_group)

# A type of more than one line adds no constant.
Type_Group_Constants {}
  group* {Type_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

# Comment lines add no constant.
Comment_Group_Constants {}
  group* {Comment_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

Group_Value {Line_Group_Constants | Type_Group_Constants | Comment_Group_Constants}

# The constants of a file's groups, in order.
# Example: a comment, "A {Integer} (2)", a type, then "B {Integer} (A * 3)" give A, 2 and B, 6.
File_Constants {}
  groups* {Group...}
  known* {Known_Constant...}
  group {Group} (groups.first)
  with_group {Group_Value} (group, known)
  result {Known_Constant...} (known)
    while (groups.count >= 1)
    next (groups.rest, with_group)

# A file as a program whose main gives the value of its last constant.
# Example: "A {Integer} (2)", then a type, then "B {Integer} (A * 3)" give main, which gives 6.
Compiled_File {}
  file {File}
  spaced {Spaced_Group...} (file.rest)
  later_groups {Group...} (spaced.group)
  groups {Group...} (file.first, later_groups...)
  known {File_Constants} (groups, Empty_String)
  last {Known_Constant} (known.last)
  kernel {Number_To_Main} (last.number)
  text {Text}
    1. {file}

# ---------- Reading input

# A reading program keeps its input in memory, from Input_Place to the end at Input_End_Place,
# and the place of the next byte at Position_Place. Each type is a function that reads it: it
# gives the place of its value and moves the position on, or gives 0 and puts the position back.
# So a part that may be missing is a call whose 0 is passed over, and a union tries each member
# in turn. A text's value is the place in the input where it starts. A number or a record is
# kept after the input, from the place that Free_Place holds.

Position_Place {Integer} (4)             # the place of the next byte
Input_End_Place {Integer} (8)            # the place after the last byte
Free_Place {Integer} (12)                # the place where the next value is kept

Slot_Size {Integer} (4)                  # a number, or the place of a field's value, is 4 bytes
Field_Size {Integer} (8)                 # a field keeps its value's place, then where it ends
Input_Place {Integer} (1024)             # where the input starts
End_Of_Input {Integer} (4294967295)      # what 'read' and take give when no byte is left
No_Most {Integer} (4294967295)           # the most count of a list with no most

Load_Input_Number {Integer} (1)
Take_Number {Integer} (2)
First_Type_Number {Integer} (3)          # each type read is a function from 3 on
Load_Input_Name {"load_input"}
Take_Name {"take"}
Type_Name_Of_Function {"type"}

Zero {Integer} (0)
Two {Integer} (2)
Three {Integer} (3)
Zero_Code {Integer} (48)                 # the number of the character "0"
Ten {Integer} (10)
Nine {Integer} (9)
Five {Integer} (5)

Tenth_Of_Most {Integer} (429496729)      # the most a number may be before one more digit

Byte_Local {Integer} (0)                 # local 0 holds the byte taken, or a digit's value
Value_Local {Integer} (1)                # local 1 holds a number's value while it is read
Try_Local {Integer} (1)                  # local 1 holds the position before a try
Item_Local {Integer} (2)                 # local 2 counts the items of a list
Start_Local {Integer} (3)                # local 3 holds the position where the function starts

Free_Local {Integer} (4)                 # local 4 holds the free place where the function starts
Record_Local {Integer} (5)               # local 5 holds the place of the record being read
Part_Local {Integer} (6)                 # local 6 holds the value of the part just read

Get {"get"}
Set {"set"}
Less {"less"}
Equal {"equal"}
Add {"add"}
Subtract {"subtract"}
Multiply {"multiply"}

Block {"block"}
Loop {"loop"}
End {"end"}
Break {"break"}
Break_If {"break_if"}

Read {"read"}
Write {"write"}
Store {"store"}
Load {"load"}
Store_Byte {"store_byte"}
Load_Byte {"load_byte"}

# How many times a part may be there: from least to most.
Count_Range {}
  least* {U32}
  most* {U32}

Any_Count {Count_Range} (Zero, No_Most)    # a list with no count
Once {Count_Range} (One, One)              # a part with no count

# A kernel instruction written with no number: "add".
Bare_Instruction {}
  word* {Kernel_Word}
  result {Instruction} (word, Empty_String, Empty_String)

# A kernel instruction written with a number: "push 5".
Number_Instruction {}
  word* {Kernel_Word}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  result {Instruction} (word, arguments, Empty_String)

# A call to a function by its number: "call 3".
Call_Instruction {}
  function* {U32}
  argument {Function_Argument} (function)
  functions {Function_Argument...} (argument)
  result {Instruction} (Call_Word, Empty_String, functions)

# Put a number in a local: "push 0", "set 1".
Local_Start {}
  number* {U32}
  local* {U32}
  push {Number_Instruction} (Push_Word, number)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (push, keep)

# Give a number from the function: "push 0", "return".
Give_Code {}
  number* {U32}
  push {Number_Instruction} (Push_Word, number)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (push, give)

# Add 1 to a local: "get 2", "push 1", "add", "set 2".
Count_Up {}
  local* {U32}
  get {Number_Instruction} (Get, local)
  push {Number_Instruction} (Push_Word, One)
  add {Bare_Instruction} (Add)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (get, push, add, keep)

# Keep the position in a local: "push 4", "load", "set 3".
Keep_Position {}
  local* {U32}
  place {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (place, load, keep)

# Put the position back from a local: "push 4", "get 3", "store".
Put_Position_Back {}
  local* {U32}
  place {Number_Instruction} (Push_Word, Position_Place)
  get {Number_Instruction} (Get, local)
  store {Bare_Instruction} (Store)
  result {Instruction...} (place, get, store)

# Take the next byte into local 0: "call 2", "set 0".
Take_Byte {}
  local* {U32}
  take {Call_Instruction} (Take_Number)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (take, keep)

# Leave as many blocks as depth, and one more, when local 0 is below a number.
Below_Code {}
  low* {U32}
  depth* {U32}
  get {Number_Instruction} (Get, Byte_Local)
  push {Number_Instruction} (Push_Word, low)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (get, push, less, leave)

# Leave as many blocks as depth, and one more, when local 0 is above a number.
Above_Code {}
  high* {U32}
  depth* {U32}
  push {Number_Instruction} (Push_Word, high)
  get {Number_Instruction} (Get, Byte_Local)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (push, get, less, leave)

# Take a byte, and leave as many blocks as depth, and one more, when it is not from low to high.
# Example: 48, 57 and 0 give the code that takes one digit.
Range_Take {}
  low* {U32}
  high* {U32}
  depth* {U32}
  take {Take_Byte} (Byte_Local)
  below {Below_Code} (low, depth)
  above {Above_Code} (high, depth)
  result {Instruction...} (take..., below..., above...)

# Take one given character, and leave as many blocks as depth, and one more, when the byte is
# another.
Character_Take {}
  code* {U32}
  depth* {U32}
  result {Range_Take} (code, code, depth)

# Leave the block around the code when a local counts fewer than the least.
Least_Leave {}
  least* {U32}
  local* {U32}
  get {Number_Instruction} (Get, local)
  push {Number_Instruction} (Push_Word, least)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (get, push, less, leave)

# Leave the loop and its block when a list has its most count.
Most_Leave {}
  most* {U32}
  get {Number_Instruction} (Get, Item_Local)
  push {Number_Instruction} (Push_Word, most)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  result {Instruction...} (get, push, less, zero, equal, leave)

# Give the value in a local from the function: "get 3", "return".
Local_Give {}
  local* {U32}
  get {Number_Instruction} (Get, local)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (get, give)

# Keep the free place in a local: "push 12", "load", "set 4".
Keep_Free {}
  local* {U32}
  place {Number_Instruction} (Push_Word, Free_Place)
  load {Bare_Instruction} (Load)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (place, load, keep)

# Put the free place back from a local: "push 12", "get 4", "store".
Put_Free_Back {}
  local* {U32}
  place {Number_Instruction} (Push_Word, Free_Place)
  get {Number_Instruction} (Get, local)
  store {Bare_Instruction} (Store)
  result {Instruction...} (place, get, store)

# Take room for a value: keep the free place in a local, and move the free place on by the size.
# Example: 5 and 12 give "push 12", "load", "set 5", "push 12", "get 5", "push 12", "add", "store".
Take_Room {}
  local* {U32}
  size* {U32}
  keep {Keep_Free} (local)
  place {Number_Instruction} (Push_Word, Free_Place)
  get {Number_Instruction} (Get, local)
  push {Number_Instruction} (Push_Word, size)
  add {Bare_Instruction} (Add)
  store {Bare_Instruction} (Store)
  result {Instruction...} (keep..., place, get, push, add, store)

# A type's function around its body: keep where it starts, and the free place. A body that
# gives no value of its own gives the place where its text starts. When the body leaves its
# block, put the position and the free place back, and give 0.
Type_Frame {}
  body* {Instruction...}
  start {Keep_Position} (Start_Local)
  free {Keep_Free} (Free_Local)
  open {Bare_Instruction} (Block)
  read {Local_Give} (Start_Local)
  close {Bare_Instruction} (End)
  back {Put_Position_Back} (Start_Local)
  free_back {Put_Free_Back} (Free_Local)
  refuse {Give_Code} (Zero)
  opening {Instruction...} (start..., free..., open)
  result {Instruction...} (opening..., body..., read..., close, back..., free_back..., refuse...)

# A part read by a function, its value kept in local 6. When the function gives 0, the block
# around the code is left, unless the least count is 0: "call 4", "set 6", "get 6", "push 0",
# "equal", "push 1", "multiply", "break_if 0".
Part_Call {}
  function* {U32}
  least* {U32}
  call {Call_Instruction} (function)
  keep {Number_Instruction} (Set, Part_Local)
  get {Number_Instruction} (Get, Part_Local)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  push {Number_Instruction} (Push_Word, least)
  both {Bare_Instruction} (Multiply)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (call, keep, get, zero, equal, push, both, leave)

# A list of parts read by a function, from its least count to its most.
# Example: function 3 with 1 to no most gives the code that reads one or more digits.
List_Call {}
  function* {U32}
  times* {Count_Range}
  start {Local_Start} (Zero, Item_Local)
  open {Bare_Instruction} (Block)
  loop {Bare_Instruction} (Loop)
  full {Most_Leave} (times.most)
  call {Call_Instruction} (function)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  next_item {Count_Up} (Item_Local)
  again {Number_Instruction} (Break, Zero)
  close {Bare_Instruction} (End)
  enough {Least_Leave} (times.least, Item_Local)
  looping {Instruction...} (open, loop, full..., call, zero, equal, leave, next_item..., again)
  result {Instruction...} (start..., looping..., close, close, enough...)

# A quoted text as a part: its characters in turn. When one is another byte, the position goes
# back to before the text, and the block around the code is left unless the least count is 0.
# Example: 45 with 0 gives the code for an optional minus sign.
Text_Try {}
  codes* {Integer...}
  least* {U32}
  done {Bare_Instruction} (Block)
  miss {Bare_Instruction} (Block)
  start {Keep_Position} (Try_Local)
  each {Character_Take...} (codes..., Zero)
  taking {Instruction...} (each.result)
  found {Number_Instruction} (Break, One)
  close {Bare_Instruction} (End)
  back {Put_Position_Back} (Try_Local)
  push {Number_Instruction} (Push_Word, least)
  refuse {Number_Instruction} (Break_If, One)
  trying {Instruction...} (done, miss, start..., taking..., found, close)
  result {Instruction...} (trying..., back..., push, refuse, close)

# Keep where the input ends, start the free place there, start the position at the first byte,
# and give 0.
Load_Input_End {}
  place* {U32}
  end_place {Number_Instruction} (Push_Word, Input_End_Place)
  at {Number_Instruction} (Get, Byte_Local)
  store {Bare_Instruction} (Store)
  free {Number_Instruction} (Push_Word, Free_Place)
  position {Number_Instruction} (Push_Word, Position_Place)
  first {Number_Instruction} (Push_Word, place)
  give {Give_Code} (Zero)
  ends {Instruction...} (end_place, at, store, free, at, store)
  result {Instruction...} (ends..., position, first, store, give...)

# The rest of load_input: stop at the end of the input; otherwise keep the byte and go on.
Load_Input_Store {}
  place* {U32}
  byte {Number_Instruction} (Get, Try_Local)
  ending {Number_Instruction} (Push_Word, End_Of_Input)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  at {Number_Instruction} (Get, Byte_Local)
  store {Bare_Instruction} (Store_Byte)
  next_place {Count_Up} (Byte_Local)
  again {Number_Instruction} (Break, Zero)
  close {Bare_Instruction} (End)
  done {Load_Input_End} (place)
  storing {Instruction...} (byte, ending, equal, leave, at, byte, store, next_place..., again)
  result {Instruction...} (storing..., close, close, done...)

# Leave as many blocks as depth, and one more, at the end of the input: "push 4", "load",
# "push 8", "load", "less", "push 0", "equal", "break_if 1".
At_End_Leave {}
  depth* {U32}
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  end_place {Number_Instruction} (Push_Word, Input_End_Place)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (position, load, end_place, load, less, zero, equal, leave)

# Look at the byte at the position, without taking it, as a digit's value in local 0. Leave as
# many blocks as depth, and one more, when it is not a digit: "push 4", "load", "load_byte",
# "push 48", "subtract", "set 0", "push 9", "get 0", "less", "break_if 1".
Digit_Look {}
  depth* {U32}
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  byte {Bare_Instruction} (Load_Byte)
  zero_code {Number_Instruction} (Push_Word, Zero_Code)
  subtract {Bare_Instruction} (Subtract)
  keep {Number_Instruction} (Set, Byte_Local)
  nine {Number_Instruction} (Push_Word, Nine)
  get {Number_Instruction} (Get, Byte_Local)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, depth)
  looking {Instruction...} (position, load, byte, zero_code, subtract, keep)
  result {Instruction...} (looking..., nine, get, less, leave)

# Leave as many blocks as depth, and one more, when one more digit would make the value too big
# for 32 bits: it fits when the value is below 429496729, or is 429496729 and the digit is at
# most 5.
Too_Big_Leave {}
  depth* {U32}
  number {Number_Instruction} (Get, Value_Local)
  tenth {Number_Instruction} (Push_Word, Tenth_Of_Most)
  less {Bare_Instruction} (Less)
  equal {Bare_Instruction} (Equal)
  five {Number_Instruction} (Push_Word, Five)
  digit {Number_Instruction} (Get, Byte_Local)
  zero {Number_Instruction} (Push_Word, Zero)
  both {Bare_Instruction} (Multiply)
  either {Bare_Instruction} (Add)
  leave {Number_Instruction} (Break_If, depth)
  below {Instruction...} (number, tenth, less)
  at_most {Instruction...} (number, tenth, equal, five, digit, less, zero, equal, both)
  result {Instruction...} (below..., at_most..., either, zero, equal, leave)

# Add the digit in local 0 to the value, and move the position on: "get 1", "push 10",
# "multiply", "get 0", "add", "set 1", then the position.
Digit_Add {}
  local* {U32}
  so_far {Number_Instruction} (Get, local)
  ten {Number_Instruction} (Push_Word, Ten)
  times {Bare_Instruction} (Multiply)
  digit {Number_Instruction} (Get, Byte_Local)
  add {Bare_Instruction} (Add)
  keep {Number_Instruction} (Set, local)
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  one {Number_Instruction} (Push_Word, One)
  store {Bare_Instruction} (Store)
  adding {Instruction...} (so_far, ten, times, digit, add, keep)
  result {Instruction...} (adding..., position, position, load, one, add, store)

# Leave the block around the code when the value is below low or above high.
Value_Range_Leave {}
  low* {U32}
  high* {U32}
  number {Number_Instruction} (Get, Value_Local)
  push_low {Number_Instruction} (Push_Word, low)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  push_high {Number_Instruction} (Push_Word, high)
  result {Instruction...} (number, push_low, less, leave, push_high, number, less, leave)

# A whole number from low to high, at least 0: its digits, one or more, then the range.
# Example: 0 and 3 read "0" to "3"; 0 and 4294967295 read any number that fits in 32 bits.
Number_Body {}
  low* {U32}
  high* {U32}
  number {Local_Start} (Zero, Value_Local)
  digits {Local_Start} (Zero, Item_Local)
  open {Bare_Instruction} (Block)
  loop {Bare_Instruction} (Loop)
  at_end {At_End_Leave} (One)
  look {Digit_Look} (One)
  too_big {Too_Big_Leave} (Two)
  add {Digit_Add} (Value_Local)
  next_digit {Count_Up} (Item_Local)
  again {Number_Instruction} (Break, Zero)
  close {Bare_Instruction} (End)
  some {Least_Leave} (One, Item_Local)
  in_range {Value_Range_Leave} (low, high)
  checks {Instruction...} (at_end..., look..., too_big...)
  reading {Instruction...} (open, loop, checks..., add..., next_digit..., again)
  result {Instruction...} (number..., digits..., reading..., close, close, some..., in_range...)

# Function 1, load_input: read every byte into memory from Input_Place, then keep where the input
# ends, and start the position at the first byte.
Load_Input_Code {}
  place* {U32}
  start {Local_Start} (place, Byte_Local)
  open {Bare_Instruction} (Block)
  loop {Bare_Instruction} (Loop)
  take {Bare_Instruction} (Read)
  keep {Number_Instruction} (Set, Try_Local)
  reading {Instruction...} (open, loop, take, keep)
  stored {Load_Input_Store} (place)
  result {Instruction...} (start..., reading..., stored...)

# The rest of take: move the position on by one, and give the byte.
Take_Move {}
  step* {U32}
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  push {Number_Instruction} (Push_Word, step)
  add {Bare_Instruction} (Add)
  store {Bare_Instruction} (Store)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (position, position, load, push, add, store, give)

# Function 2, take: the byte at the position, moving the position on; or 4294967295 at the end
# of the input, leaving the position where it is.
Take_Code {}
  ending* {U32}
  open {Bare_Instruction} (Block)
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  end_place {Number_Instruction} (Push_Word, Input_End_Place)
  less {Bare_Instruction} (Less)
  more {Number_Instruction} (Break_If, Zero)
  push {Give_Code} (ending)
  close {Bare_Instruction} (End)
  byte {Bare_Instruction} (Load_Byte)
  moved {Take_Move} (One)
  testing {Instruction...} (open, position, load, end_place, load, less, more, push..., close)
  result {Instruction...} (testing..., position, load, byte, moved...)

# Leave the block unless the position is at the end of the input.
At_End_Check {}
  place* {U32}
  position {Number_Instruction} (Push_Word, place)
  load {Bare_Instruction} (Load)
  end_place {Number_Instruction} (Push_Word, Input_End_Place)
  equal {Bare_Instruction} (Equal)
  zero {Number_Instruction} (Push_Word, Zero)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (position, load, end_place, load, equal, zero, equal, leave)

# Write the input that was read, from Input_Place to the position, and give 0.
Write_Input_Code {}
  place* {U32}
  start {Local_Start} (place, Try_Local)
  open {Bare_Instruction} (Block)
  loop {Bare_Instruction} (Loop)
  at {Number_Instruction} (Get, Try_Local)
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  byte {Bare_Instruction} (Load_Byte)
  write {Bare_Instruction} (Write)
  next_place {Count_Up} (Try_Local)
  again {Number_Instruction} (Break, Zero)
  close {Bare_Instruction} (End)
  give {Give_Code} (Zero)
  testing {Instruction...} (open, loop, at, position, load, less, zero, equal, leave)
  writing {Instruction...} (at, byte, write, next_place..., again, close, close)
  result {Instruction...} (start..., testing..., writing..., give...)

# Main: load the input, and read it with the top type's function. When the type reads all of
# it, main writes it and gives 0; otherwise main gives 1.
# Example: Natural on "2026" writes "2026" and gives 0; on "12a" it gives 1.
Reading_Main {}
  top* {U32}
  load {Call_Instruction} (Load_Input_Number)
  drop {Bare_Instruction} (Stack_Word)
  call {Call_Instruction} (top)
  keep {Number_Instruction} (Set, Byte_Local)
  open {Bare_Instruction} (Block)
  read {Number_Instruction} (Get, Byte_Local)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  refused {Number_Instruction} (Break_If, Zero)
  whole {At_End_Check} (Position_Place)
  write {Write_Input_Code} (Input_Place)
  close {Bare_Instruction} (End)
  refuse {Give_Code} (One)
  checking {Instruction...} (load, drop, call, keep, open, read, zero, equal, refused, whole...)
  result {Instruction...} (checking..., write..., close, refuse...)

# ---------- From Etale to reading code

# A step after a field's name, as in 'number.count': its name, and the code that gives its number
# from the place where the field's value is kept.
Step_Code {}
  name* {Field_Name}
  code* {Instruction...}

Count_Name {"count"}

# A field's count: 1 when its value is kept, 0 when it is missing: "load", "push 0", "equal",
# "push 0", "equal".
Count_Step {}
  name* {Field_Name}
  load {Bare_Instruction} (Load)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  code {Instruction...} (load, zero, equal, zero, equal)
  result {Step_Code} (name, code)

# A field's value in a record: its name, how far from the record's start it is kept, and the
# steps that may come after its name.
Field_Slot {}
  name* {Field_Name}
  offset* {U32}
  steps* {Step_Code...}

# What a type's function holds: its code, how many values it takes, and the slots of its fields.
Type_Code {}
  instructions* {Instruction...}
  inputs* {Input_Count}
  slots* {Field_Slot...}

# A type compiled to the body of its function: its name, its function's number, and its code.
Compiled_Type {}
  name* {Type_Name}
  number* {U32}
  code* {Type_Code}

# The code of a type that is read from the text: it takes nothing, and keeps no fields.
Reading_Code {}
  instructions* {Instruction...}
  result {Type_Code} (instructions, Zero, Empty_String)

# The number of the function that reads a type of this name, among the types compiled above.
# Example: "Digit", after Digit is compiled as function 3, gives 3.
Type_Number {}
  wanted* {Type_Name}
  types* {Compiled_Type...}
  found {Compiled_Type...} (types.name = wanted)
  type {Compiled_Type} (found.first)
  result {Integer} (type.number)

# A printable character's number.
# Example: "0" gives 48.
Character_Code {}
  character* {Line_Character}
  result {Integer} (character)
    {32..126} (" ".."~")

# An escape's number: a newline, a quote or a backslash.
# Example: '\n' gives 10.
Escape_Number {}
  code* {Escape_Code}
  result {Integer} (code)
    {10} ("n")
    {34} (Quote)
    {92} (Backslash)

# A character in quotes: its number, as written or as an escape.
Plain_Number {}
  character* {Plain_String_Character}
  result {Character_Code} (character)

# An escape in quotes: its number.
Escaped_Number {}
  character* {Escape}
  result {Escape_Number} (character.code)

Character_Number {Plain_Number | Escaped_Number}

# The numbers of characters, each after the numbers so far.
# Example: "." and "." with none so far give 46, 46.
Characters_To_Codes {}
  characters* {String_Character...}
  codes_so_far* {Integer...}
  character {String_Character} (characters.first)
  code {Character_Number} (character)
  with_code {Integer...} (codes_so_far..., code)
  result {Integer...} (codes_so_far)
    while (characters.count >= 1)
    next (characters.rest, with_code)

# The numbers of the characters in quotes.
# Example: '".."' gives 46, 46.
Quoted_Codes {}
  quoted* {String_Literal}
  characters {String_Character...} (quoted.characters)
  codes {Characters_To_Codes} (characters, Empty_String)
  result {Integer...} (codes)

# The number of the one character in quotes.
# Example: '"0"' gives 48.
Quoted_Code {}
  quoted* {String_Literal}
  codes {Quoted_Codes} (quoted)
  one_character {Needs} (codes.count = 1)
  result {Integer} (codes.first)

# The number that digits write, each digit after the number so far.
# Example: "12" with 0 so far gives 1, then 12.
Digits_Value {}
  digits* {Digit...}
  so_far* {Integer} (0..)
  digit {Digit} (digits.first)
  code {Character_Code} (digit)
  digit_value {Integer} (code - Zero_Code)
  tens {Integer} (so_far * Ten)
  with_digit {Integer} (tens + digit_value)
  result {Integer} (so_far)
    while (digits.count >= 1)
    next (digits.rest, with_digit)

# A count from a low number up: '1..' gives 1 to no most.
Lower_Count {}
  quantity* {Lower_Range}
  otherwise* {Count_Range}
  result {Count_Range} (quantity.low, No_Most)

# A count from low to high: '0..1' gives 0 to 1.
Bounded_Count {}
  quantity* {Bounded_Range}
  otherwise* {Count_Range}
  result {Count_Range} (quantity.low, quantity.high)

# A count of one number: 'count: 8' gives 8 to 8.
Exact_Count {}
  quantity* {Natural}
  otherwise* {Count_Range}
  number {Digits_Value} (quantity, Zero)
  result {Count_Range} (number, number)

Quantity_Count {Lower_Count | Bounded_Count | Exact_Count}

# The count a count property gives.
Count_Of_Count {}
  property* {Count_Property}
  otherwise* {Count_Range}
  counted {Quantity_Count} (property.allowed, otherwise)
  result {Count_Range} (counted.least, counted.most)

# Any other property gives the count there is with no count property.
Other_Count {}
  property* {Places_Property | Round_Property | Wrap_Property | List_Property}
  otherwise* {Count_Range}
  result {Count_Range} (otherwise)

Property_Count {Count_Of_Count | Other_Count}

# The count a line's properties give, or the otherwise count when they give none.
# Example: 'count: 0..1' gives 0 to 1; no properties and Once give 1 to 1.
Count_Of {}
  written* {Properties...}
  otherwise* {Count_Range}
  firsts {Property...} (written.first)
  found {Property_Count...} (firsts..., otherwise)
  with_otherwise {Count_Range...} (found..., otherwise)
  result {Count_Range} (with_otherwise.first)

# Keep the position as the best so far, when it is further than the best: "get 2", "push 4",
# "load", "less", "push 0", "equal", "break_if 0", "push 4", "load", "set 2".
Keep_Best {}
  local* {U32}
  best {Number_Instruction} (Get, local)
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, Zero)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (best, position, load, less, zero, equal, leave, position, load, keep)

# A union member that is a type: call its function; when it reads, keep where it got to.
# Then go back to where the union started, for the next member.
# Example: Digit, function 3, gives "block", "call 3", "push 0", "equal", "break_if 0", ...
Union_Name_Try {}
  item* {Type_Name}
  types* {Compiled_Type...}
  number {Type_Number} (item, types)
  open {Bare_Instruction} (Block)
  call {Call_Instruction} (number)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  miss {Number_Instruction} (Break_If, Zero)
  best {Keep_Best} (Item_Local)
  close {Bare_Instruction} (End)
  back {Put_Position_Back} (Start_Local)
  result {Instruction...} (open, call, zero, equal, miss, best..., close, back...)

# A union member that is a quoted text: take its characters; when they all read, keep where it
# got to. Then go back to where the union started.
Union_Text_Try {}
  item* {String_Literal}
  types* {Compiled_Type...}
  codes {Quoted_Codes} (item)
  open {Bare_Instruction} (Block)
  each {Character_Take...} (codes..., Zero)
  taking {Instruction...} (each.result)
  best {Keep_Best} (Item_Local)
  close {Bare_Instruction} (End)
  back {Put_Position_Back} (Start_Local)
  result {Instruction...} (open, taking..., best..., close, back...)

# A union member that is a character range: take one character of it, as Union_Text_Try does.
Union_Range_Try {}
  item* {Character_Range}
  types* {Compiled_Type...}
  low {Quoted_Code} (item.low)
  high {Quoted_Code} (item.high)
  open {Bare_Instruction} (Block)
  take {Range_Take} (low, high, Zero)
  best {Keep_Best} (Item_Local)
  close {Bare_Instruction} (End)
  back {Put_Position_Back} (Start_Local)
  result {Instruction...} (open, take..., best..., close, back...)

Union_Try {Union_Name_Try | Union_Text_Try | Union_Range_Try}

# Move the position to the best: "push 4", "get 2", "store".
Best_Position {}
  local* {U32}
  result {Put_Position_Back} (local)

# A union's body: try each member from where the union starts, and keep the furthest any of
# them reads to. The union reads to there. When none reads, the function's block is left.
# Example: '"break" | "break_if"' reads "break_if" whole.
Union_Body {}
  items* {Union_List}
  types* {Compiled_Type...}
  rest {Union_Tail...} (items.rest)
  others {Union_Item...} (rest.next)
  members {Union_Item...} (items.first, others...)
  start {Local_Start} (Zero, Item_Local)
  tries {Union_Try...} (members..., types)
  trying {Instruction...} (tries.result)
  best {Number_Instruction} (Get, Item_Local)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  none {Number_Instruction} (Break_If, Zero)
  moved {Best_Position} (Item_Local)
  result {Instruction...} (start..., trying..., best, zero, equal, none, moved...)

# A character range's body: one character of it.
# Example: '"0".."9"' reads one digit.
Range_Body {}
  items* {Character_Range}
  types* {Compiled_Type...}
  low {Quoted_Code} (items.low)
  high {Quoted_Code} (items.high)
  result {Range_Take} (low, high, Zero)

Union_Base_Body {Union_Body | Range_Body}

# The body of a union box.
Union_Box_Body {}
  box* {Union_Box}
  types* {Compiled_Type...}
  result {Union_Base_Body} (box.items, types)

# A union line as a compiled type, numbered after the types above it.
Union_Line_Type {}
  line* {Union_Line}
  types* {Compiled_Type...}
  number {Integer} (First_Type_Number + types.count)
  body {Union_Box_Body} (line.base, types)
  code {Reading_Code} (body)
  compiled {Compiled_Type} (line.name, number, code)
  result {Compiled_Type...} (compiled)

# A list box's body: the item type's function, called from the least count to the most.
# Example: 'Digit...' with 1 to no most reads one or more digits.
List_Box_Body {}
  box* {List_Box}
  types* {Compiled_Type...}
  times* {Count_Range}
  number {Type_Number} (box.item, types)
  result {List_Call} (number, times)

# A list line as a compiled type.
# Example: 'Natural {Digit...} count: 1..' gives Natural's function.
List_Line_Type {}
  box* {List_Box}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  written {Properties...} (line.properties)
  times {Count_Of} (written, Any_Count)
  number {Integer} (First_Type_Number + types.count)
  body {List_Box_Body} (box, types, times)
  code {Reading_Code} (body)
  compiled {Compiled_Type} (line.name, number, code)
  result {Compiled_Type...} (compiled)

# Keep a number in a local after the input, and give its place.
# Example: 1 gives "push 12", "load", "set 0", ..., "get 0", "get 1", "store", "get 0", "return".
Number_Give {}
  local* {U32}
  room {Take_Room} (Byte_Local, Slot_Size)
  place {Number_Instruction} (Get, Byte_Local)
  number {Number_Instruction} (Get, local)
  store {Bare_Instruction} (Store)
  give {Local_Give} (Byte_Local)
  result {Instruction...} (room..., place, number, store, give...)

# Parentheses that hold a range from low to high, at least 0, make a number type. Its value is
# the number.
Range_Content_Type {}
  content* {Bounded_Range}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  reading {Number_Body} (content.low, content.high)
  give {Number_Give} (Value_Local)
  body {Instruction...} (reading..., give...)
  number {Integer} (First_Type_Number + types.count)
  code {Reading_Code} (body)
  compiled {Compiled_Type} (line.name, number, code)
  result {Compiled_Type...} (compiled)

# Any other parentheses, such as a constant's calculation, make no type.
Other_Content_Type {}
  content* {Allowed_Choice | Lower_Range | Upper_Range | Calculation | Conditions | Call_Values}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  result {Compiled_Type...} (Empty_String)

Content_Type {Range_Content_Type | Other_Content_Type}

# A line of one quoted text is a type that reads the text.
# Example: 'Push_Word {"push"}' reads "push".
Text_Item_Type {}
  item* {String_Literal}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  codes {Quoted_Codes} (item)
  body {Text_Try} (codes, One)
  number {Integer} (First_Type_Number + types.count)
  code {Reading_Code} (body)
  compiled {Compiled_Type} (line.name, number, code)
  result {Compiled_Type...} (compiled)

# A line of one type: a number range is a type that reads it; a constant or anything else
# gives no type.
# Example: 'U32 {Integer} (0..4294967295)' reads a whole number that fits in 32 bits.
Named_Item_Type {}
  item* {Type_Name}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  written_parens {Parens...} (line.parens)
  contents {Paren_Content...} (written_parens.content)
  found {Content_Type...} (contents..., line, types)
  result {Compiled_Type...} (found.result)

# A line of one number gives no type.
Number_Item_Type {}
  item* {Number_Literal}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  result {Compiled_Type...} (Empty_String)

Item_Kind_Type {Text_Item_Type | Named_Item_Type | Number_Item_Type}

# A refinement line of one item.
Item_Line_Type {}
  box* {Item_Box}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  result {Item_Kind_Type} (box.item, line, types)

Refinement_Base_Type {List_Line_Type | Item_Line_Type}

# A refinement line: a list gives its type; one item gives none.
Refinement_Line_Type {}
  line* {Refinement_Line}
  types* {Compiled_Type...}
  result {Refinement_Base_Type} (line.base, line, types)

# An intersection line is not compiled yet: it gives no type.
Intersection_Line_Type {}
  line* {Intersection_Line}
  types* {Compiled_Type...}
  result {Compiled_Type...} (Empty_String)

Line_Type {Union_Line_Type | Refinement_Line_Type | Intersection_Line_Type}

# A quoted text in a layout.
# Example: '"-"' with 0 to 1 gives an optional minus sign.
Quoted_Part {}
  item* {String_Literal}
  types* {Compiled_Type...}
  times* {Count_Range}
  codes {Quoted_Codes} (item)
  result {Text_Try} (codes, times.least)

# A type in a layout, by its name.
# Example: 'Digit' with 0 to 1 gives an optional digit.
Named_Part {}
  item* {Type_Name}
  types* {Compiled_Type...}
  times* {Count_Range}
  number {Type_Number} (item, types)
  result {Part_Call} (number, times.least)

Single_Part {Quoted_Part | Named_Part}

# A box of one item in a layout.
Item_Box_Part {}
  box* {Item_Box}
  types* {Compiled_Type...}
  times* {Count_Range}
  result {Single_Part} (box.item, types, times)

# A list in a layout.
List_Box_Part {}
  box* {List_Box}
  types* {Compiled_Type...}
  times* {Count_Range}
  result {List_Box_Body} (box, types, times)

Box_Part {Item_Box_Part | List_Box_Part}

# One position of a layout. With no count, the position must be there once.
# Example: '  1. {"-"} count: 0..1' gives the code for an optional minus sign.
Position_Part {}
  line* {Position_Line}
  types* {Compiled_Type...}
  written {Properties...} (line.properties)
  times {Count_Of} (written, Once)
  result {Box_Part} (line.base, types, times)

# The name a layout's head line gives.
Head_Name {}
  head* {Refinement_Line}
  result {Type_Name} (head.name)

# A layout as a compiled type: its positions in order.
# Example: Integer_Literal gives a function that reads an optional minus sign, then digits.
Layout_Type {}
  block* {Layout_Block}
  types* {Compiled_Type...}
  name {Head_Name} (block.head)
  parts {Position_Part...} (block.positions..., types)
  body {Instruction...} (parts.result)
  number {Integer} (First_Type_Number + types.count)
  code {Reading_Code} (body)
  compiled {Compiled_Type} (name, number, code)
  result {Compiled_Type...} (compiled)

# A field of a record: its name, its line, and how far from the record's start it is kept.
Known_Field {}
  name* {Field_Name}
  line* {Plain_Field}
  offset* {U32}

# The name of a field line.
Field_Line_Name {}
  line* {Field_Line}
  result {Field_Name} (line.name)

# The name of a union field line.
Union_Field_Name {}
  line* {Union_Field_Line}
  result {Field_Name} (line.name)

# The name of a field worked out by cases.
Mapping_Name {}
  head* {Mapping_Line}
  result {Field_Name} (head.name)

# The name of a field worked out by cases, from its head line.
Mapped_Field_Name {}
  line* {Mapped_Field}
  result {Mapping_Name} (line.head)

Line_Name {Field_Line_Name | Union_Field_Name | Mapped_Field_Name}

# A record's fields, each kept 8 bytes after the one above it, from 8 on.
# Example: the lines of word, number and function give word 8, number 16 and function 24.
Numbered_Fields {}
  lines* {Plain_Field...}
  known* {Known_Field...}
  line {Plain_Field} (lines.first)
  name {Line_Name} (line)
  place {Integer} (known.count + One)
  offset {Integer} (place * Field_Size)
  added {Known_Field} (name, line, offset)
  with_line {Known_Field...} (known..., added)
  result {Known_Field...} (known)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# A field's line as a part: its type, with the field's count. With no count, the field is
# there once.
# Example: 'number* {Number_Argument} count: 0..1' gives an optional " 5".
Field_Line_Part {}
  line* {Field_Line}
  types* {Compiled_Type...}
  written {Properties...} (line.properties)
  times {Count_Of} (written, Once)
  result {Box_Part} (line.base, types, times)

# The name a field box gives.
Field_Box_Name {}
  box* {Field_Box}
  result {Field_Name} (box.field)

# Keep where the text just read ends, 4 bytes after the field's value: "get 5", "push 12",
# "add", "push 4", "load", "store".
End_Store {}
  offset* {U32}
  end {Integer} (offset + Slot_Size)
  record {Number_Instruction} (Get, Record_Local)
  push {Number_Instruction} (Push_Word, end)
  add {Bare_Instruction} (Add)
  position {Number_Instruction} (Push_Word, Position_Place)
  load {Bare_Instruction} (Load)
  store {Bare_Instruction} (Store)
  result {Instruction...} (record, push, add, position, load, store)

# Keep the part just read in the record, at a place from its start, and where it ends:
# "get 5", "push 8", "add", "get 6", "store", then the end.
Slot_Store {}
  offset* {U32}
  record {Number_Instruction} (Get, Record_Local)
  push {Number_Instruction} (Push_Word, offset)
  add {Bare_Instruction} (Add)
  part {Number_Instruction} (Get, Part_Local)
  store {Bare_Instruction} (Store)
  end {End_Store} (offset)
  result {Instruction...} (record, push, add, part, store, end...)

# A shape position that names a field: the field's line, read as a part, and its value kept in
# the record.
# Example: '    2. {word}' reads the record's word.
Field_Position_Part {}
  position* {Field_Position}
  fields* {Known_Field...}
  types* {Compiled_Type...}
  wanted {Field_Box_Name} (position.base)
  found {Known_Field...} (fields.name = wanted)
  field {Known_Field} (found.first)
  part {Field_Line_Part} (field.line, types)
  store {Slot_Store} (field.offset)
  result {Instruction...} (part..., store...)

# A shape position of a type or a quoted text, read as a layout position is.
# Example: '    1. {"  "}' reads two spaces.
Type_Position_Part {}
  position* {Type_Position}
  fields* {Known_Field...}
  types* {Compiled_Type...}
  written {Properties...} (position.properties)
  times {Count_Of} (written, Once)
  result {Box_Part} (position.base, types, times)

Shape_Part {Field_Position_Part | Type_Position_Part}

# ---------- Rules

# A field's slot, with the steps that may come after its name.
# Example: number, kept at 16, gives number, 16, and the step count.
Known_Slot {}
  field* {Known_Field}
  types* {Compiled_Type...}
  counting {Count_Step} (Count_Name)
  steps {Step_Code...} (counting)
  slot {Field_Slot} (field.name, field.offset, steps)
  result {Field_Slot...} (slot)

Needs_Word {"Needs"}
Claims_Word {"Claims"}

Equal_Sign {"="}
Less_Sign {"<"}
More_Sign {">"}
At_Most_Sign {"<="}
At_Least_Sign {">="}

# A field's number, for a test: the place kept in the record, then the number at that place.
# Example: low, kept 4 bytes from the start, gives "get 5", "push 4", "add", "load", "load".
Name_Code {}
  written* {Name}
  offsets* {Field_Slot...}
  found {Field_Slot...} (offsets.name = written)
  slot {Field_Slot} (found.first)
  record {Number_Instruction} (Get, Record_Local)
  push {Number_Instruction} (Push_Word, slot.offset)
  add {Bare_Instruction} (Add)
  load {Bare_Instruction} (Load)
  result {Instruction...} (record, push, add, load, load)

# A whole number, for a test.
# Example: "10" gives "push 10".
Literal_Code {}
  written* {Number_Literal}
  offsets* {Field_Slot...}
  number {Literal_Value} (written, Empty_String)
  push {Number_Instruction} (Push_Word, number)
  result {Instruction...} (push)

# The name a path starts with.
Path_Name {}
  path* {Stepped_Path}
  result {Name} (path.first)

# The name of a path's step.
Step_Name {}
  step* {Field_Step}
  result {Field_Name} (step.name)

# A field's name and a step, for a test: the place kept in the record, then the step's code.
# Example: 'number.count', kept 8 bytes from the start, gives "get 5", "push 8", "add", then
# the count.
Stepped_Code {}
  written* {Stepped_Path}
  offsets* {Field_Slot...}
  field {Path_Name} (written)
  found {Field_Slot...} (offsets.name = field)
  slot {Field_Slot} (found.first)
  wanted {Step_Name} (written.step)
  steps {Step_Code...} (slot.steps)
  found_steps {Step_Code...} (steps.name = wanted)
  step {Step_Code} (found_steps.first)
  record {Number_Instruction} (Get, Record_Local)
  push {Number_Instruction} (Push_Word, slot.offset)
  add {Bare_Instruction} (Add)
  result {Instruction...} (record, push, add, step.code...)

Path_Code {Name_Code | Stepped_Code}
Value_Code {Name_Code | Stepped_Code | Literal_Code}

# Leave the block around the code, as many blocks as depth and one more, when the top of the
# stack is 0: "push 0", "equal", "break_if 0".
Leave_Unless {}
  depth* {U32}
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (zero, equal, leave)

# 'a = b' holds when they are equal.
Equal_Test {}
  symbol* {Equal_Sign}
  left* {Instruction...}
  right* {Instruction...}
  equal {Bare_Instruction} (Equal)
  unless {Leave_Unless} (Zero)
  result {Instruction...} (left..., right..., equal, unless...)

# 'a < b' holds when a is less.
Less_Test {}
  symbol* {Less_Sign}
  left* {Instruction...}
  right* {Instruction...}
  less {Bare_Instruction} (Less)
  unless {Leave_Unless} (Zero)
  result {Instruction...} (left..., right..., less, unless...)

# 'a > b' holds when b is less.
More_Test {}
  symbol* {More_Sign}
  left* {Instruction...}
  right* {Instruction...}
  less {Bare_Instruction} (Less)
  unless {Leave_Unless} (Zero)
  result {Instruction...} (right..., left..., less, unless...)

# 'a <= b' fails when b is less.
At_Most_Test {}
  symbol* {At_Most_Sign}
  left* {Instruction...}
  right* {Instruction...}
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (right..., left..., less, leave)

# 'a >= b' fails when a is less.
At_Least_Test {}
  symbol* {At_Least_Sign}
  left* {Instruction...}
  right* {Instruction...}
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (left..., right..., less, leave)

Symbol_Test {Equal_Test | Less_Test | More_Test | At_Most_Test | At_Least_Test}

# A comparison by a symbol: the test of its symbol.
Symbol_Code {}
  comparison* {Symbol_Comparison}
  left* {Instruction...}
  right* {Instruction...}
  result {Symbol_Test} (comparison.symbol, left, right)

# One condition: its field, its value, and the test between them. When the test fails, the
# function's block is left, and the record is refused.
# Example: 'low <= high' gives the numbers of high and low, then "less", "break_if 0".
Condition_Code {}
  condition* {Condition}
  offsets* {Field_Slot...}
  left {Path_Code} (condition.field, offsets)
  right {Value_Code} (condition.right, offsets)
  result {Symbol_Code} (condition.comparison, left, right)

# Conditions joined by '&': each one tested in turn.
And_Code {}
  conditions* {And_Conditions}
  offsets* {Field_Slot...}
  tails {And_Tail...} (conditions.rest)
  others {Condition...} (tails.next)
  all {Condition...} (conditions.first, others...)
  tests {Condition_Code...} (all..., offsets)
  result {Instruction...} (tests.result)

# A {Needs} line is tested when the record is read.
Needs_Rule {}
  kind* {Needs_Word}
  conditions* {And_Conditions}
  offsets* {Field_Slot...}
  result {And_Code} (conditions, offsets)

# A {Claims} line is proven when the file is checked, so it is not tested when it runs.
Claims_Rule {}
  kind* {Claims_Word}
  conditions* {And_Conditions}
  offsets* {Field_Slot...}
  result {Instruction...} (Empty_String)

Named_Rule {Needs_Rule | Claims_Rule}

# A line of one type with conditions is a rule: {Needs} or {Claims}.
Item_Box_Rule {}
  box* {Item_Box}
  conditions* {And_Conditions}
  offsets* {Field_Slot...}
  result {Named_Rule} (box.item, conditions, offsets)

# A list with conditions keeps the items that meet them: it is not a rule.
List_Box_Rule {}
  box* {List_Box}
  conditions* {And_Conditions}
  offsets* {Field_Slot...}
  result {Instruction...} (Empty_String)

Box_Rule {Item_Box_Rule | List_Box_Rule}

# Parentheses that hold conditions joined by '&'. Conditions joined by '|' are not compiled yet.
Conditions_Rule {}
  content* {And_Conditions}
  base* {Base_Box}
  offsets* {Field_Slot...}
  result {Box_Rule} (base, content, offsets)

# Parentheses that hold anything else are not a rule.
No_Rule {}
  content* {Allowed_Choice | Range_Literal | Calculation | Call_Values}
  base* {Base_Box}
  offsets* {Field_Slot...}
  result {Instruction...} (Empty_String)

Content_Rule {Conditions_Rule | No_Rule}

# A field line's test, when it is a rule.
# Example: 'in_order {Needs} (low <= high)' gives the test of 'low <= high'.
Field_Line_Rule {}
  line* {Field_Line}
  offsets* {Field_Slot...}
  written_parens {Parens...} (line.parens)
  contents {Paren_Content...} (written_parens.content)
  found {Content_Rule...} (contents..., line.base, offsets)
  result {Instruction...} (found.result)

# A union field or a field worked out by cases is not a rule.
Other_Line_Rule {}
  line* {Union_Field_Line | Mapped_Field}
  offsets* {Field_Slot...}
  result {Instruction...} (Empty_String)

Line_Rule {Field_Line_Rule | Other_Line_Rule}

# The name a record's head gives.
Record_Name {}
  head* {Record_Header}
  result {Type_Name} (head.name)

# The positions of a shape.
Positions_Of_Shape {}
  shape* {Shape}
  result {Shape_Position...} (shape.positions)

# The positions of a shape item.
Shape_Positions {}
  item* {Shape_Item}
  result {Positions_Of_Shape} (item.line)

# Take room for a record: 8 bytes for each field, after 8 bytes at its start.
# Example: 3 fields take 32 bytes.
Record_Room {}
  fields* {Known_Field...}
  places {Integer} (fields.count + One)
  size {Integer} (places * Field_Size)
  result {Take_Room} (Record_Local, size)

# A record's body: take its room, read the shape's positions in order, then test its rules.
# Its value is the record's place.
# Example: kernel.etale's Instruction reads "  push 5" and a newline.
Record_Body {}
  shape* {Shape_Item}
  block* {Record_Block}
  types* {Compiled_Type...}
  items {Field_Item...} (block.fields)
  lines {Plain_Field...} (items.line)
  fields {Numbered_Fields} (lines, Empty_String)
  positions {Shape_Positions} (shape)
  room {Record_Room} (fields)
  parts {Shape_Part...} (positions..., fields, types)
  reading {Instruction...} (parts.result)
  slots {Known_Slot...} (fields..., types)
  offsets {Field_Slot...} (slots.result)
  rules {Line_Rule...} (lines..., offsets)
  testing {Instruction...} (rules.result)
  give {Local_Give} (Record_Local)
  code {Instruction...} (room..., reading..., testing..., give...)
  result {Type_Code} (code, Zero, offsets)

# A record's text shape as a compiled type.
Shape_Type {}
  shape* {Shape_Item}
  block* {Record_Block}
  types* {Compiled_Type...}
  body {Record_Body} (shape, block, types)
  name {Record_Name} (block.head)
  number {Integer} (First_Type_Number + types.count)
  compiled {Compiled_Type} (name, number, body)
  result {Compiled_Type...} (compiled)

# A record of fields gives a type when it has a text shape; with no shape, none yet.
Record_Type {}
  block* {Record_Block}
  types* {Compiled_Type...}
  shapes {Shape_Item...} (block.shape)
  made {Shape_Type...} (shapes..., block, types)
  result {Compiled_Type...} (made.result)

# A repeating record is not compiled yet: it gives no type.
Repeating_Type {}
  block* {Repeating_Block}
  types* {Compiled_Type...}
  result {Compiled_Type...} (Empty_String)

Long_Type {Layout_Type | Record_Type | Repeating_Type}

# The types of a group of lines, compiled in order, each after the types above it.
Lines_Types {}
  lines* {Noted_Line...}
  types* {Compiled_Type...}
  noted {Noted_Line} (lines.first)
  added {Line_Type} (noted.line, types)
  with_line {Compiled_Type...} (types..., added...)
  result {Compiled_Type...} (types)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# A group of one-line declarations adds its types.
Line_Group_Types {}
  group* {Line_Group}
  types* {Compiled_Type...}
  lines {Noted_Line...} (group.first, group.rest...)
  with_group {Lines_Types} (lines, types)
  result {Compiled_Type...} (with_group)

# A type of more than one line adds its type, when it is compiled.
Type_Group_Types {}
  group* {Type_Group}
  types* {Compiled_Type...}
  added {Long_Type} (group.type, types)
  result {Compiled_Type...} (types..., added...)

# Comment lines add no type.
Comment_Group_Types {}
  group* {Comment_Group}
  types* {Compiled_Type...}
  result {Compiled_Type...} (types)

Group_Types {Line_Group_Types | Type_Group_Types | Comment_Group_Types}

# The types of a file's groups, in order.
File_Types {}
  groups* {Group...}
  types* {Compiled_Type...}
  group {Group} (groups.first)
  with_group {Group_Types} (group, types)
  result {Compiled_Type...} (types)
    while (groups.count >= 1)
    next (groups.rest, with_group)

# Main, load_input and take: functions 0, 1 and 2, which take nothing.
Fixed_Functions {}
  main_code* {Instruction...}
  load_code* {Instruction...}
  take_code* {Instruction...}
  main_head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (main_head, main_code)
  load_head {Function_Head} (Load_Input_Number, Load_Input_Name, No_Inputs)
  load {Function} (load_head, load_code)
  take_head {Function_Head} (Take_Number, Take_Name, No_Inputs)
  take {Function} (take_head, take_code)
  result {Function...} (main, load, take)

# The instructions of a type's code.
Code_Instructions {}
  code* {Type_Code}
  result {Instruction...} (code.instructions)

# How many values a type's code takes.
Code_Inputs {}
  code* {Type_Code}
  result {Input_Count} (code.inputs)

# A compiled type's function: its body in the type's frame, and how many values it takes.
Type_Function {}
  type* {Compiled_Type}
  name* {Kernel_Name}
  inputs {Code_Inputs} (type.code)
  head {Function_Head} (type.number, name, inputs)
  body {Code_Instructions} (type.code)
  framed {Type_Frame} (body)
  result {Function} (head, framed)

# A reading program: main, load_input, take, and a function for each type, from 3 on. Main reads
# with the last type.
Reading_Program {}
  types* {Compiled_Type...} count: 1..
  top {Compiled_Type} (types.last)
  main_code {Reading_Main} (top.number)
  load_code {Load_Input_Code} (Input_Place)
  take_code {Take_Code} (End_Of_Input)
  fixed {Fixed_Functions} (main_code, load_code, take_code)
  typed {Type_Function...} (types..., Type_Name_Of_Function)
  functions {Function...} (fixed..., typed...)
  result {Program} (functions)

# A file as a program that reads its last type from the input.
# Example: Digit, Natural and Integer_Literal give a program that reads "-42", writes it and
# gives 0.
Compiled_Reader {}
  file {File}
  spaced {Spaced_Group...} (file.rest)
  later_groups {Group...} (spaced.group)
  groups {Group...} (file.first, later_groups...)
  types {File_Types} (groups, Empty_String)
  reader {Reading_Program} (types)
  text {Text}
    1. {file}
