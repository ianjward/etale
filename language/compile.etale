# Etale compiled to the kernel: each Compiled type reads Etale text, and makes a kernel Program.

Main_Number {Integer} (0)                # main is function 0
Main_Name {"main"}
No_Inputs {Integer} (0)                  # main takes nothing
One {Integer} (1)

# A program whose main gives one number.
# Example: 7 gives "function 0 main takes 0", then "push 7" and "return".
Number_To_Main {}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  push {Instruction} (Push_Word, arguments, Empty_String)
  give {Instruction} (Return_Word, Empty_String, Empty_String)
  instructions {Instruction...} (push, give)
  head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (head, instructions)
  functions {Function...} (main)
  result {Program} (functions)

# A constant worked out while compiling: its name and its value, which a kernel number holds.
Known_Constant {}
  name* {Type_Name}
  number* {U32}

# A whole number as it is written.
# Example: "7" gives 7.
Literal_Value {}
  written* {Number_Literal}
  known* {Known_Constant...}
  result {Integer} (written)

# A constant's name: the value of the constant of that name, above it.
# Example: "Group_Width", after "Group_Width {Integer} (7)", gives 7.
Name_Value {}
  written* {Path}
  known* {Known_Constant...}
  found {Known_Constant...} (known.name = written)
  constant {Known_Constant} (found.first)
  result {Integer} (constant.number)

# A term is a number or a name.
Term_Value {Literal_Value | Name_Value}

# A product of whole numbers: each number times the product so far.
# Example: 2, 3 and 4 with 1 so far give 24.
Product_Of {}
  numbers* {Integer...}
  so_far* {Integer} (0..)
  number {Integer} (numbers.first)
  product {Integer} (so_far * number)
  result {Integer} (so_far)
    while (numbers.count >= 1)
    next (numbers.rest, product)

# A sum, worked out while compiling.
# Example: "1 + Group_Width" gives 8.
Addition_Value {}
  written* {Sum}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Sum_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first + rest_total)

# A difference: the first term less each of the others.
# Example: "10 - 2 - 3" gives 5.
Subtraction_Value {}
  written* {Difference}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Difference_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first - rest_total)

# A product of terms.
# Example: "2 * 3 * 4" gives 24.
Multiplication_Value {}
  written* {Product}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Product_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  product {Product_Of} (others, first)
  result {Integer} (product)

# A quotient that divides exactly. A divisor of 0, or a remainder, is refused.
# Example: "Group_Values / 2" gives 64.
Division_Value {}
  written* {Quotient}
  known* {Known_Constant...}
  dividend {Term_Value} (written.dividend, known)
  divisor {Term_Value} (written.divisor, known)
  division {Division} (dividend, divisor)
  exact {Needs} (division.remainder = 0)
  result {Integer} (division.quotient)

# A calculation makes the one of these that takes it.
Operation_Value {Addition_Value | Subtraction_Value | Multiplication_Value | Division_Value}
Calculation_Value {Term_Value | Operation_Value}

# The value of the calculation in parentheses.
Parens_Value {}
  parens* {Parens}
  known* {Known_Constant...}
  calculation {Calculation_Value} (parens.content, known)
  result {Integer} (calculation)

# A calculation in parentheses adds a constant: the line's name, and the calculation's value.
# Example: "(Group_Width * 18)" on Group_Values gives Group_Values, 126.
Calculation_Constant {}
  written* {Calculation}
  name* {Type_Name}
  known* {Known_Constant...}
  worked {Calculation_Value} (written, known)
  constant {Known_Constant} (name, worked)
  result {Known_Constant...} (constant)

# Parentheses that hold a range, a choice, conditions or a call add no constant.
# Example: "(0..9)" adds nothing.
No_Constant {}
  written* {Range_Literal | Allowed_Choice | Conditions | Call_Values}
  name* {Type_Name}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Content_Constants {Calculation_Constant | No_Constant}

# A refinement line adds a constant when its parentheses hold a calculation.
# Example: "Group_Width {Integer} (7)" adds Group_Width, 7. "Text {Character...}" adds nothing.
Refinement_Constants {}
  line* {Refinement_Line}
  known* {Known_Constant...}
  written_parens {Parens...} (line.parens)
  contents {Paren_Content...} (written_parens.content)
  found {Content_Constants...} (contents..., line.name, known)
  result {Known_Constant...} (found.result)

# A union line or an intersection line adds no constant.
Other_Line_Constants {}
  line* {Union_Line | Intersection_Line}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Line_Constants {Refinement_Constants | Other_Line_Constants}

# The constants of a group of lines, worked out in order: each may name the ones above it.
# Example: "A {Integer} (2)" then "B {Integer} (A * 3)" give A, 2 and B, 6.
Group_Constants {}
  lines* {Noted_Line...}
  known* {Known_Constant...}
  noted {Noted_Line} (lines.first)
  added {Line_Constants} (noted.line, known)
  with_line {Known_Constant...} (known..., added...)
  result {Known_Constant...} (known)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# A group of one-line declarations adds its constants.
Line_Group_Constants {}
  group* {Line_Group}
  known* {Known_Constant...}
  lines {Noted_Line...} (group.first, group.rest...)
  with_group {Group_Constants} (lines, known)
  result {Known_Constant...} (with_group)

# A type of more than one line adds no constant.
Type_Group_Constants {}
  group* {Type_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

# Comment lines add no constant.
Comment_Group_Constants {}
  group* {Comment_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

Group_Value {Line_Group_Constants | Type_Group_Constants | Comment_Group_Constants}

# The constants of a file's groups, in order.
# Example: a comment, "A {Integer} (2)", a type, then "B {Integer} (A * 3)" give A, 2 and B, 6.
File_Constants {}
  groups* {Group...}
  known* {Known_Constant...}
  group {Group} (groups.first)
  with_group {Group_Value} (group, known)
  result {Known_Constant...} (known)
    while (groups.count >= 1)
    next (groups.rest, with_group)

# A file as a program whose main gives the value of its last constant.
# Example: "A {Integer} (2)", then a type, then "B {Integer} (A * 3)" give main, which gives 6.
Compiled_File {}
  file {File}
  spaced {Spaced_Group...} (file.rest)
  later_groups {Group...} (spaced.group)
  groups {Group...} (file.first, later_groups...)
  known {File_Constants} (groups, Empty_String)
  last {Known_Constant} (known.last)
  kernel {Number_To_Main} (last.number)
  text {Text}
    1. {file}

# ---------- Reading input

# Kernel code that reads text keeps what it reads as a text record: its count at its place, and
# its characters, a byte each, after it. A record's place is never 0, so 0 means refused.
# Function 2, take, gives the next byte. Function 3, give_back, keeps a byte for the next take,
# so that a list can stop at a byte that is not one of its items.

Record_Place {Integer} (16)              # where the record read is kept
Items_Place {Integer} (20)               # where its characters start
Kept_Byte_Place {Integer} (4)            # a byte given back
Kept_Flag_Place {Integer} (8)            # 1 while a byte is given back
End_Of_Input {Integer} (4294967295)      # what 'read' gives when no byte is left
No_Most {Integer} (4294967295)           # the most count of a list with no most

Zero_Code {Integer} (48)                 # the number of the character "0"
Ten {Integer} (10)

Reader_Number {Integer} (1)
Take_Number {Integer} (2)
Give_Back_Number {Integer} (3)
Reader_Name {"reader"}
Take_Name {"take"}
Give_Back_Name {"give_back"}

Zero {Integer} (0)
Two {Integer} (2)
Byte_Local {Integer} (0)                 # local 0 holds the byte read
Count_Local {Integer} (1)                # local 1 counts the characters of the text
Item_Local {Integer} (2)                 # local 2 counts the items of a list

Get {"get"}
Set {"set"}
Less {"less"}
Equal {"equal"}
Add {"add"}

Block {"block"}
Loop {"loop"}
End {"end"}
Break {"break"}
Break_If {"break_if"}

Read {"read"}
Write {"write"}
Store {"store"}
Load {"load"}
Store_Byte {"store_byte"}
Load_Byte {"load_byte"}

# How many times a position or a list's items may be there: from least to most.
Count_Range {}
  least* {U32}
  most* {U32}

Any_Count {Count_Range} (Zero, No_Most)    # a list with no count
Once {Count_Range} (One, One)              # a position with no count

# A kernel instruction written with no number: "add".
Bare_Instruction {}
  word* {Kernel_Word}
  result {Instruction} (word, Empty_String, Empty_String)

# A kernel instruction written with a number: "push 5".
Number_Instruction {}
  word* {Kernel_Word}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  result {Instruction} (word, arguments, Empty_String)

# A call to a function by its number: "call 1".
Call_Instruction {}
  function* {U32}
  argument {Function_Argument} (function)
  functions {Function_Argument...} (argument)
  result {Instruction} (Call_Word, Empty_String, functions)

# Put a number in a local: "push 0", "set 1".
Local_Start {}
  number* {U32}
  local* {U32}
  push {Number_Instruction} (Push_Word, number)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (push, keep)

# Give a number from the function: "push 0", "return".
Give_Code {}
  number* {U32}
  push {Number_Instruction} (Push_Word, number)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (push, give)

# Take the next byte into a local: "call 2", "set 0".
Take_Byte {}
  local* {U32}
  take {Call_Instruction} (Take_Number)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (take, keep)

# Give the byte in a local back, for the next take: "get 0", "call 3", "drop".
Give_Back_Byte {}
  local* {U32}
  get {Number_Instruction} (Get, local)
  give {Call_Instruction} (Give_Back_Number)
  drop {Bare_Instruction} (Stack_Word)
  result {Instruction...} (get, give, drop)

# Add 1 to a local: "get 1", "push 1", "add", "set 1".
Count_Up {}
  local* {U32}
  get {Number_Instruction} (Get, local)
  push {Number_Instruction} (Push_Word, One)
  add {Bare_Instruction} (Add)
  keep {Number_Instruction} (Set, local)
  result {Instruction...} (get, push, add, keep)

# Keep the byte as the next character of the text, and count it: "push 20", "get 1", "add",
# "get 0", "store_byte", then add 1 to local 1.
Keep_Byte {}
  place* {U32}
  push {Number_Instruction} (Push_Word, place)
  counted {Number_Instruction} (Get, Count_Local)
  add {Bare_Instruction} (Add)
  get {Number_Instruction} (Get, Byte_Local)
  store {Bare_Instruction} (Store_Byte)
  next_count {Count_Up} (Count_Local)
  result {Instruction...} (push, counted, add, get, store, next_count...)

# Leave as many blocks as depth, and one more, when local 0 is below a number.
# Example: 48 and 0 give "get 0", "push 48", "less", "break_if 0".
Below_Code {}
  low* {U32}
  depth* {U32}
  get {Number_Instruction} (Get, Byte_Local)
  push {Number_Instruction} (Push_Word, low)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (get, push, less, leave)

# Leave as many blocks as depth, and one more, when local 0 is above a number.
# Example: 57 and 0 give "push 57", "get 0", "less", "break_if 0".
Above_Code {}
  high* {U32}
  depth* {U32}
  push {Number_Instruction} (Push_Word, high)
  get {Number_Instruction} (Get, Byte_Local)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (push, get, less, leave)

# Leave as many blocks as depth, and one more, when local 0 is below low or above high.
# Example: 48, 57 and 0 give the tests for a digit.
Range_Leave {}
  low* {U32}
  high* {U32}
  depth* {U32}
  below {Below_Code} (low, depth)
  above {Above_Code} (high, depth)
  result {Instruction...} (below..., above...)

# Leave as many blocks as depth, and one more, when local 0 is not a character.
# Example: 45 and 0 give "get 0", "push 45", "equal", "push 0", "equal", "break_if 0".
Other_Leave {}
  code* {U32}
  depth* {U32}
  get {Number_Instruction} (Get, Byte_Local)
  push {Number_Instruction} (Push_Word, code)
  equal {Bare_Instruction} (Equal)
  zero {Number_Instruction} (Push_Word, Zero)
  leave {Number_Instruction} (Break_If, depth)
  result {Instruction...} (get, push, equal, zero, equal, leave)

# Leave the block around the code when a local counts fewer than the least.
# Example: 1 and 2 give "get 2", "push 1", "less", "break_if 0".
Least_Leave {}
  least* {U32}
  local* {U32}
  get {Number_Instruction} (Get, local)
  push {Number_Instruction} (Push_Word, least)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (get, push, less, leave)

# Keep the count of the text as the first field of the record, and give its place.
# Example: 16 gives "push 16", "get 1", "store", "push 16", "return".
Hold_Count {}
  place* {U32}
  push {Number_Instruction} (Push_Word, place)
  counted {Number_Instruction} (Get, Count_Local)
  store {Bare_Instruction} (Store)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (push, counted, store, push, give)

# One character from low to high, which must be there.
# Example: 48 and 57 give the code that reads one digit.
Range_Position_Code {}
  low* {U32}
  high* {U32}
  take {Take_Byte} (Byte_Local)
  outside {Range_Leave} (low, high, Zero)
  keep {Keep_Byte} (Items_Place)
  result {Instruction...} (take..., outside..., keep...)

# One character from low to high. When the next byte is another, it is given back, and the text
# is refused unless the least count is 0.
# Example: 48, 57 and 0 give the code for an optional digit.
One_Position_Code {}
  low* {U32}
  high* {U32}
  least* {U32}
  done {Bare_Instruction} (Block)
  absent {Bare_Instruction} (Block)
  take {Take_Byte} (Byte_Local)
  other {Range_Leave} (low, high, Zero)
  keep {Keep_Byte} (Items_Place)
  found {Number_Instruction} (Break, One)
  close {Bare_Instruction} (End)
  back {Give_Back_Byte} (Byte_Local)
  push {Number_Instruction} (Push_Word, least)
  refuse {Number_Instruction} (Break_If, One)
  matching {Instruction...} (done, absent, take..., other..., keep..., found, close)
  result {Instruction...} (matching..., back..., push, refuse, close)

# Leave the loop and its block when a list has its most count: "get 2", "push 7", "less",
# "push 0", "equal", "break_if 1".
Most_Leave {}
  most* {U32}
  get {Number_Instruction} (Get, Item_Local)
  push {Number_Instruction} (Push_Word, most)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  result {Instruction...} (get, push, less, zero, equal, leave)

# One given character, from it to itself.
# Example: 45 and 0 give the code for an optional minus sign.
Character_Position_Code {}
  code* {U32}
  least* {U32}
  result {One_Position_Code} (code, code, least)

# The loop of a list: stop at the most count; take a byte; keep and count it while it is from
# low to high. The first byte that is not an item is given back, and the loop and its block are
# left.
List_Loop {}
  low* {U32}
  high* {U32}
  most* {U32}
  open {Bare_Instruction} (Loop)
  full {Most_Leave} (most)
  take {Take_Byte} (Byte_Local)
  item {Bare_Instruction} (Block)
  outside {Range_Leave} (low, high, Zero)
  keep {Keep_Byte} (Items_Place)
  next_item {Count_Up} (Item_Local)
  again {Number_Instruction} (Break, One)
  close {Bare_Instruction} (End)
  back {Give_Back_Byte} (Byte_Local)
  leave {Number_Instruction} (Break, One)
  testing {Instruction...} (item, outside..., keep..., next_item..., again, close)
  result {Instruction...} (open, full..., take..., testing..., back..., leave, close)

# A list of characters from low to high, with a count from its least to its most.
# Example: 48, 57 and 1 to no most give the code that reads a whole number.
List_Position_Code {}
  low* {U32}
  high* {U32}
  times* {Count_Range}
  start {Local_Start} (Zero, Item_Local)
  open {Bare_Instruction} (Block)
  items {List_Loop} (low, high, times.most)
  close {Bare_Instruction} (End)
  enough {Least_Leave} (times.least, Item_Local)
  result {Instruction...} (start..., open, items..., close, enough...)

# The reader's code: the code of each position in order, inside one block. A position that does
# not read leaves the block, and the reader gives 0. Otherwise it gives the place of the text.
Layout_Code {}
  positions* {Instruction...} count: 1..
  start {Local_Start} (Zero, Count_Local)
  open {Bare_Instruction} (Block)
  hold {Hold_Count} (Record_Place)
  close {Bare_Instruction} (End)
  refuse {Give_Code} (Zero)
  result {Instruction...} (start..., open, positions..., hold..., close, refuse...)

# Function 2, take: the byte given back, if there is one, otherwise the next byte read.
Take_Code {}
  flag* {U32}
  byte* {U32}
  open {Bare_Instruction} (Block)
  flag_place {Number_Instruction} (Push_Word, flag)
  load {Bare_Instruction} (Load)
  zero {Number_Instruction} (Push_Word, Zero)
  equal {Bare_Instruction} (Equal)
  none {Number_Instruction} (Break_If, Zero)
  store {Bare_Instruction} (Store)
  byte_place {Number_Instruction} (Push_Word, byte)
  give {Bare_Instruction} (Return_Word)
  close {Bare_Instruction} (End)
  read {Bare_Instruction} (Read)
  kept {Instruction...} (open, flag_place, load, zero, equal, none, flag_place, zero, store)
  result {Instruction...} (kept..., byte_place, load, give, close, read, give)

# Function 3, give_back: keep the byte it takes for the next take, and give 0.
Give_Back_Code {}
  flag* {U32}
  byte* {U32}
  byte_place {Number_Instruction} (Push_Word, byte)
  get {Number_Instruction} (Get, Byte_Local)
  store {Bare_Instruction} (Store)
  flag_place {Number_Instruction} (Push_Word, flag)
  one {Number_Instruction} (Push_Word, One)
  give {Give_Code} (Zero)
  result {Instruction...} (byte_place, get, store, flag_place, one, store, give...)

# Leave the block unless the input is used up: "call 2", "push 4294967295", "equal", "push 0",
# "equal", "break_if 0".
End_Check {}
  end_value* {U32}
  take {Call_Instruction} (Take_Number)
  push {Number_Instruction} (Push_Word, end_value)
  equal {Bare_Instruction} (Equal)
  zero {Number_Instruction} (Push_Word, Zero)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (take, push, equal, zero, equal, leave)

# Leave the block when local 0 holds 0, the refused place.
Refused_Check {}
  number* {U32}
  get {Number_Instruction} (Get, Byte_Local)
  push {Number_Instruction} (Push_Word, number)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (get, push, equal, leave)

# Leave the loop and its block when every character is written.
Characters_Left {}
  number* {U32}
  counted {Number_Instruction} (Get, Count_Local)
  place {Number_Instruction} (Get, Byte_Local)
  load {Bare_Instruction} (Load)
  less {Bare_Instruction} (Less)
  zero {Number_Instruction} (Push_Word, number)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, One)
  result {Instruction...} (counted, place, load, less, zero, equal, leave)

# Write the next character of the text: "push 20", "get 1", "add", "load_byte", "write".
Write_Item {}
  place* {U32}
  push {Number_Instruction} (Push_Word, place)
  counted {Number_Instruction} (Get, Count_Local)
  add {Bare_Instruction} (Add)
  load {Bare_Instruction} (Load_Byte)
  write {Bare_Instruction} (Write)
  result {Instruction...} (push, counted, add, load, write)

# Write each character of the text at local 0, and give 0.
Write_Text_Code {}
  number* {U32}
  start {Local_Start} (Zero, Count_Local)
  open {Bare_Instruction} (Block)
  loop {Bare_Instruction} (Loop)
  left {Characters_Left} (Zero)
  item {Write_Item} (Items_Place)
  next_count {Count_Up} (Count_Local)
  again {Number_Instruction} (Break, Zero)
  close {Bare_Instruction} (End)
  give {Give_Code} (number)
  writing {Instruction...} (open, loop, left..., item..., next_count..., again, close, close)
  result {Instruction...} (start..., writing..., give...)

# Main: read the whole input as one text. Main writes it and gives 0, or gives 1 when the input
# is refused, or when bytes are left after the text.
# Example: "7" writes "7" and gives 0; "x" gives 1.
Reading_Main {}
  show* {Instruction...}
  call {Call_Instruction} (Reader_Number)
  keep {Number_Instruction} (Set, Byte_Local)
  open {Bare_Instruction} (Block)
  refused {Refused_Check} (Zero)
  whole {End_Check} (End_Of_Input)
  close {Bare_Instruction} (End)
  refuse {Give_Code} (One)
  result {Instruction...} (call, keep, open, refused..., whole..., show..., close, refuse...)

# Main, the reader and take, functions 0 to 2, which take nothing.
Reading_Functions {}
  main_code* {Instruction...}
  reader_code* {Instruction...}
  take_code* {Instruction...}
  main_head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (main_head, main_code)
  reader_head {Function_Head} (Reader_Number, Reader_Name, No_Inputs)
  reader {Function} (reader_head, reader_code)
  take_head {Function_Head} (Take_Number, Take_Name, No_Inputs)
  take {Function} (take_head, take_code)
  result {Function...} (main, reader, take)

# Function 3, give_back, which takes the byte.
Give_Back_Function {}
  code* {Instruction...}
  head {Function_Head} (Give_Back_Number, Give_Back_Name, One)
  result {Function} (head, code)

# A program that reads its input with the reader's code, then writes what it read.
Reading_Program {}
  code* {Instruction...} count: 1..
  reader_code {Layout_Code} (code)
  show {Write_Text_Code} (Zero)
  main_code {Reading_Main} (show)
  take_code {Take_Code} (Kept_Flag_Place, Kept_Byte_Place)
  back_code {Give_Back_Code} (Kept_Flag_Place, Kept_Byte_Place)
  functions {Reading_Functions} (main_code, reader_code, take_code)
  with_back {Give_Back_Function} (back_code)
  all {Function...} (functions..., with_back)
  result {Program} (all)

# ---------- From Etale to reading code

# A printable character's number.
# Example: "0" gives 48.
Character_Code {}
  character* {Line_Character}
  result {Integer} (character)
    {32..126} (" ".."~")

# The number of the one character in quotes.
# Example: '"0"' gives 48.
Quoted_Code {}
  quoted* {String_Literal}
  characters {String_Character...} (quoted.characters)
  one_character {Needs} (characters.count = 1)
  character {String_Character} (characters.first)
  code {Character_Code} (character)
  result {Integer} (code)

# The numbers of characters, each after the numbers so far.
# Example: "." and "." with none so far give 46, 46.
Characters_To_Codes {}
  characters* {String_Character...}
  codes_so_far* {Integer...}
  character {String_Character} (characters.first)
  code {Character_Code} (character)
  with_code {Integer...} (codes_so_far..., code)
  result {Integer...} (codes_so_far)
    while (characters.count >= 1)
    next (characters.rest, with_code)

# The numbers of the characters in quotes.
# Example: '".."' gives 46, 46.
Quoted_Codes {}
  quoted* {String_Literal}
  characters {String_Character...} (quoted.characters)
  codes {Characters_To_Codes} (characters, Empty_String)
  result {Integer...} (codes)

# The code that reads a character of a range.
# Example: '"0".."9"' gives the program that reads one digit.
Range_Reader {}
  range* {Character_Range}
  low {Quoted_Code} (range.low)
  high {Quoted_Code} (range.high)
  code {Range_Position_Code} (low, high)
  result {Reading_Program} (code)

# The code that reads a union line's one character range.
Box_Reader {}
  box* {Union_Box}
  result {Range_Reader} (box.items)

# A type of one character range as a program that reads it from its input.
# Example: 'Digit {"0".."9"}' gives a program that reads one digit, writes it and gives 0.
Compiled_Range {}
  line {Union_Line}
  reader {Box_Reader} (line.base)
  text {Text}
    1. {line}

# A character range's type: its name, and the numbers of its ends.
Known_Range {}
  name* {Type_Name}
  low* {U32}
  high* {U32}

# A base of one character range adds its range, for the line's name.
# Example: '"0".."9"' on Digit adds Digit, 48, 57.
Range_Known {}
  items* {Character_Range}
  name* {Type_Name}
  low {Quoted_Code} (items.low)
  high {Quoted_Code} (items.high)
  known {Known_Range} (name, low, high)
  result {Known_Range...} (known)

# A union of several items adds no range.
Union_No_Range {}
  items* {Union_List}
  name* {Type_Name}
  result {Known_Range...} (Empty_String)

Box_Ranges {Range_Known | Union_No_Range}

# The range a union box adds, for the line's name.
Box_Items_Ranges {}
  box* {Union_Box}
  name* {Type_Name}
  result {Box_Ranges} (box.items, name)

# A union line adds its range when its base is one character range.
Union_Line_Ranges {}
  line* {Union_Line}
  result {Box_Items_Ranges} (line.base, line.name)

# A refinement line or an intersection line adds no range.
Other_Line_Ranges {}
  line* {Refinement_Line | Intersection_Line}
  result {Known_Range...} (Empty_String)

Line_Ranges {Union_Line_Ranges | Other_Line_Ranges}

# The ranges of a group of lines, in order.
# Example: 'Digit {"0".."9"}' then 'Natural {Digit...} count: 1..' give Digit, 48, 57.
Group_Ranges {}
  lines* {Noted_Line...}
  known* {Known_Range...}
  noted {Noted_Line} (lines.first)
  added {Line_Ranges} (noted.line)
  with_line {Known_Range...} (known..., added...)
  result {Known_Range...} (known)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# The number that digits write, each digit after the number so far.
# Example: "12" with 0 so far gives 1, then 12.
Digits_Value {}
  digits* {Digit...}
  so_far* {Integer} (0..)
  digit {Digit} (digits.first)
  code {Character_Code} (digit)
  digit_value {Integer} (code - Zero_Code)
  tens {Integer} (so_far * Ten)
  with_digit {Integer} (tens + digit_value)
  result {Integer} (so_far)
    while (digits.count >= 1)
    next (digits.rest, with_digit)

# A count from a low number up: '1..' gives 1 to no most.
Lower_Count {}
  quantity* {Lower_Range}
  otherwise* {Count_Range}
  result {Count_Range} (quantity.low, No_Most)

# A count from low to high: '0..1' gives 0 to 1.
Bounded_Count {}
  quantity* {Bounded_Range}
  otherwise* {Count_Range}
  result {Count_Range} (quantity.low, quantity.high)

# A count of one number: 'count: 8' gives 8 to 8.
Exact_Count {}
  quantity* {Natural}
  otherwise* {Count_Range}
  number {Digits_Value} (quantity, Zero)
  result {Count_Range} (number, number)

Quantity_Count {Lower_Count | Bounded_Count | Exact_Count}

# The count a count property gives.
Count_Of_Count {}
  property* {Count_Property}
  otherwise* {Count_Range}
  counted {Quantity_Count} (property.allowed, otherwise)
  result {Count_Range} (counted.least, counted.most)

# Any other property gives the count there is with no count property.
Other_Count {}
  property* {Places_Property | Round_Property | Wrap_Property | List_Property}
  otherwise* {Count_Range}
  result {Count_Range} (otherwise)

Property_Count {Count_Of_Count | Other_Count}

# The count a line's properties give, or the otherwise count when they give none.
# Example: 'count: 0..1' gives 0 to 1; no properties and Once give 1 to 1.
Count_Of {}
  written* {Properties...}
  otherwise* {Count_Range}
  firsts {Property...} (written.first)
  found {Property_Count...} (firsts..., otherwise)
  with_otherwise {Count_Range...} (found..., otherwise)
  result {Count_Range} (with_otherwise.first)

# The code that reads a list of a known range, with its least count.
# Example: Digit, Digit's range and 1 give the code that reads a whole number.
Known_List_Code {}
  item* {Type_Name}
  known* {Known_Range...}
  times* {Count_Range}
  found {Known_Range...} (known.name = item)
  range {Known_Range} (found.first)
  result {List_Position_Code} (range.low, range.high, times)

# The code that reads a list box's items, with their count.
List_Box_Code {}
  box* {List_Box}
  known* {Known_Range...}
  times* {Count_Range}
  result {Known_List_Code} (box.item, known, times)

# The code that reads a quoted text, each character in turn. Only a text of one character may
# be missing.
# Example: '"-"' with 0 to 1 gives an optional minus sign; '".."' gives two dots.
Quoted_Item_Code {}
  item* {String_Literal}
  known* {Known_Range...}
  times* {Count_Range}
  codes {Quoted_Codes} (item)
  missing_one {Needs} (times.least = 1 | codes.count = 1)
  each {Character_Position_Code...} (codes..., times.least)
  result {Instruction...} (each.result)

# The code that reads one character of a known range, by its type's name.
# Example: 'Digit' with 0 to 1 gives an optional digit.
Named_Item_Code {}
  item* {Type_Name}
  known* {Known_Range...}
  times* {Count_Range}
  found {Known_Range...} (known.name = item)
  range {Known_Range} (found.first)
  result {One_Position_Code} (range.low, range.high, times.least)

Single_Item_Code {Quoted_Item_Code | Named_Item_Code}

# The code that reads a box's one item: a quoted text, or a character of a known range.
Item_Box_Code {}
  box* {Item_Box}
  known* {Known_Range...}
  times* {Count_Range}
  result {Single_Item_Code} (box.item, known, times)

Box_Code {Item_Box_Code | List_Box_Code}

# A list on a refinement line: with no count, any count.
# Example: 'Natural {Digit...} count: 1..' gives the code that reads a whole number.
List_Line_Code {}
  line* {Refinement_Line}
  known* {Known_Range...}
  written {Properties...} (line.properties)
  times {Count_Of} (written, Any_Count)
  code {List_Box_Code} (line.base, known, times)
  result {Reading_Program} (code)

# A group of lines whose last line is a list of a character range, as a program that reads it.
# Example: 'Digit {"0".."9"}' then 'Natural {Digit...} count: 1..' give a program that reads a
# whole number, writes it and gives 0.
Compiled_List {}
  group {Line_Group}
  lines {Noted_Line...} (group.first, group.rest...)
  known {Group_Ranges} (lines, Empty_String)
  last {Noted_Line} (lines.last)
  reader {List_Line_Code} (last.line, known)
  text {Text}
    1. {group}

# A group of one-line declarations adds its ranges.
Line_Group_Ranges {}
  group* {Line_Group}
  known* {Known_Range...}
  lines {Noted_Line...} (group.first, group.rest...)
  with_group {Group_Ranges} (lines, known)
  result {Known_Range...} (with_group)

# A type of more than one line adds no range.
Type_Group_Ranges {}
  group* {Type_Group}
  known* {Known_Range...}
  result {Known_Range...} (known)

# Comment lines add no range.
Comment_Group_Ranges {}
  group* {Comment_Group}
  known* {Known_Range...}
  result {Known_Range...} (known)

Group_Ranges_Value {Line_Group_Ranges | Type_Group_Ranges | Comment_Group_Ranges}

# The ranges of a file's groups, in order.
File_Ranges {}
  groups* {Group...}
  known* {Known_Range...}
  group {Group} (groups.first)
  with_group {Group_Ranges_Value} (group, known)
  result {Known_Range...} (known)
    while (groups.count >= 1)
    next (groups.rest, with_group)

# The code of one position of a layout. With no count, the position must be there once.
# Example: '  1. {"-"} count: 0..1' gives the code for an optional minus sign.
Position_Line_Code {}
  line* {Position_Line}
  known* {Known_Range...}
  written {Properties...} (line.properties)
  times {Count_Of} (written, Once)
  result {Box_Code} (line.base, known, times)

# A layout as a program that reads it: the code of each position, in order.
# Example: Integer_Literal gives a program that reads an optional minus sign, then digits.
Layout_Block_Code {}
  block* {Layout_Block}
  known* {Known_Range...}
  codes {Position_Line_Code...} (block.positions..., known)
  steps {Instruction...} (codes.result)
  result {Reading_Program} (steps)

# A type group that holds a layout.
Layout_Group_Code {}
  group* {Type_Group}
  known* {Known_Range...}
  result {Layout_Block_Code} (group.type, known)

# A file whose last group is a layout of character ranges and quoted characters, as a program
# that reads the layout.
# Example: Digit, then Integer_Literal, give a program that reads "-42", writes it and gives 0.
Compiled_Layout {}
  file {File}
  spaced {Spaced_Group...} (file.rest)
  later_groups {Group...} (spaced.group)
  groups {Group...} (file.first, later_groups...)
  known {File_Ranges} (groups, Empty_String)
  last {Group} (groups.last)
  reader {Layout_Group_Code} (last, known)
  text {Text}
    1. {file}
