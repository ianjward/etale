# Etale compiled to the kernel: each Compiled type reads Etale text, and makes a kernel Program.

Main_Number {Integer} (0)                # main is function 0
Main_Name {"main"}
No_Inputs {Integer} (0)                  # main takes nothing
One {Integer} (1)

# A program whose main gives one number.
# Example: 7 gives "function 0 main takes 0", then "push 7" and "return".
Number_To_Main {}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  push {Instruction} (Push_Word, arguments, Empty_String)
  give {Instruction} (Return_Word, Empty_String, Empty_String)
  instructions {Instruction...} (push, give)
  head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (head, instructions)
  functions {Function...} (main)
  result {Program} (functions)

# A constant worked out while compiling: its name and its value, which a kernel number holds.
Known_Constant {}
  name* {Type_Name}
  number* {U32}

# A whole number as it is written.
# Example: "7" gives 7.
Literal_Value {}
  written* {Number_Literal}
  known* {Known_Constant...}
  result {Integer} (written)

# A constant's name: the value of the constant of that name, above it.
# Example: "Group_Width", after "Group_Width {Integer} (7)", gives 7.
Name_Value {}
  written* {Path}
  known* {Known_Constant...}
  found {Known_Constant...} (known.name = written)
  constant {Known_Constant} (found.first)
  result {Integer} (constant.number)

# A term is a number or a name.
Term_Value {Literal_Value | Name_Value}

# A product of whole numbers: each number times the product so far.
# Example: 2, 3 and 4 with 1 so far give 24.
Product_Of {}
  numbers* {Integer...}
  so_far* {Integer} (0..)
  number {Integer} (numbers.first)
  product {Integer} (so_far * number)
  result {Integer} (so_far)
    while (numbers.count >= 1)
    next (numbers.rest, product)

# A sum, worked out while compiling.
# Example: "1 + Group_Width" gives 8.
Addition_Value {}
  written* {Sum}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Sum_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first + rest_total)

# A difference: the first term less each of the others.
# Example: "10 - 2 - 3" gives 5.
Subtraction_Value {}
  written* {Difference}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Difference_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  rest_total {Integer} (others.sum)
  result {Integer} (first - rest_total)

# A product of terms.
# Example: "2 * 3 * 4" gives 24.
Multiplication_Value {}
  written* {Product}
  known* {Known_Constant...}
  first {Term_Value} (written.first, known)
  tails {Product_Tail...} (written.rest)
  terms {Term...} (tails.next)
  others {Term_Value...} (terms..., known)
  product {Product_Of} (others, first)
  result {Integer} (product)

# A quotient that divides exactly. A divisor of 0, or a remainder, is refused.
# Example: "Group_Values / 2" gives 64.
Division_Value {}
  written* {Quotient}
  known* {Known_Constant...}
  dividend {Term_Value} (written.dividend, known)
  divisor {Term_Value} (written.divisor, known)
  division {Division} (dividend, divisor)
  exact {Needs} (division.remainder = 0)
  result {Integer} (division.quotient)

# A calculation makes the one of these that takes it.
Operation_Value {Addition_Value | Subtraction_Value | Multiplication_Value | Division_Value}
Calculation_Value {Term_Value | Operation_Value}

# The value of the calculation in parentheses.
Parens_Value {}
  parens* {Parens}
  known* {Known_Constant...}
  calculation {Calculation_Value} (parens.content, known)
  result {Integer} (calculation)

# A calculation in parentheses adds a constant: the line's name, and the calculation's value.
# Example: "(Group_Width * 18)" on Group_Values gives Group_Values, 126.
Calculation_Constant {}
  written* {Calculation}
  name* {Type_Name}
  known* {Known_Constant...}
  worked {Calculation_Value} (written, known)
  constant {Known_Constant} (name, worked)
  result {Known_Constant...} (constant)

# Parentheses that hold a range, a choice, conditions or a call add no constant.
# Example: "(0..9)" adds nothing.
No_Constant {}
  written* {Range_Literal | Allowed_Choice | Conditions | Call_Values}
  name* {Type_Name}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Content_Constants {Calculation_Constant | No_Constant}

# A refinement line adds a constant when its parentheses hold a calculation.
# Example: "Group_Width {Integer} (7)" adds Group_Width, 7. "Text {Character...}" adds nothing.
Refinement_Constants {}
  line* {Refinement_Line}
  known* {Known_Constant...}
  written_parens {Parens...} (line.parens)
  contents {Paren_Content...} (written_parens.content)
  found {Content_Constants...} (contents..., line.name, known)
  result {Known_Constant...} (found.result)

# A union line or an intersection line adds no constant.
Other_Line_Constants {}
  line* {Union_Line | Intersection_Line}
  known* {Known_Constant...}
  result {Known_Constant...} (Empty_String)

Line_Constants {Refinement_Constants | Other_Line_Constants}

# The constants of a group of lines, worked out in order: each may name the ones above it.
# Example: "A {Integer} (2)" then "B {Integer} (A * 3)" give A, 2 and B, 6.
Group_Constants {}
  lines* {Noted_Line...}
  known* {Known_Constant...}
  noted {Noted_Line} (lines.first)
  added {Line_Constants} (noted.line, known)
  with_line {Known_Constant...} (known..., added...)
  result {Known_Constant...} (known)
    while (lines.count >= 1)
    next (lines.rest, with_line)

# A group of one-line declarations adds its constants.
Line_Group_Constants {}
  group* {Line_Group}
  known* {Known_Constant...}
  lines {Noted_Line...} (group.first, group.rest...)
  with_group {Group_Constants} (lines, known)
  result {Known_Constant...} (with_group)

# A type of more than one line adds no constant.
Type_Group_Constants {}
  group* {Type_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

# Comment lines add no constant.
Comment_Group_Constants {}
  group* {Comment_Group}
  known* {Known_Constant...}
  result {Known_Constant...} (known)

Group_Value {Line_Group_Constants | Type_Group_Constants | Comment_Group_Constants}

# The constants of a file's groups, in order.
# Example: a comment, "A {Integer} (2)", a type, then "B {Integer} (A * 3)" give A, 2 and B, 6.
File_Constants {}
  groups* {Group...}
  known* {Known_Constant...}
  group {Group} (groups.first)
  with_group {Group_Value} (group, known)
  result {Known_Constant...} (known)
    while (groups.count >= 1)
    next (groups.rest, with_group)

# A file as a program whose main gives the value of its last constant.
# Example: "A {Integer} (2)", then a type, then "B {Integer} (A * 3)" give main, which gives 6.
Compiled_File {}
  file {File}
  spaced {Spaced_Group...} (file.rest)
  later_groups {Group...} (spaced.group)
  groups {Group...} (file.first, later_groups...)
  known {File_Constants} (groups, Empty_String)
  last {Known_Constant} (known.last)
  kernel {Number_To_Main} (last.number)
  text {Text}
    1. {file}

# ---------- Reading input

# Kernel code that reads text works on the bytes 'read' gives, and keeps each record it reads
# at a place in memory. A record's place is never 0, so 0 means refused.

Record_Place {Integer} (16)              # where the record read is kept
Reader_Number {Integer} (1)              # the function that reads the record
Reader_Name {"reader"}
Zero {Integer} (0)
End_Of_Input {Integer} (4294967295)      # what 'read' gives when no byte is left

Get {"get"}
Set {"set"}
Less {"less"}
Equal {"equal"}

Block {"block"}
End {"end"}
Break_If {"break_if"}
Read {"read"}
Write {"write"}
Store {"store"}
Load {"load"}

# A kernel instruction written with no number: "add".
Bare_Instruction {}
  word* {Kernel_Word}
  result {Instruction} (word, Empty_String, Empty_String)

# A kernel instruction written with a number: "push 5".
Number_Instruction {}
  word* {Kernel_Word}
  number* {U32}
  argument {Number_Argument} (number)
  arguments {Number_Argument...} (argument)
  result {Instruction} (word, arguments, Empty_String)

# A call to a function by its number: "call 1".
Call_Instruction {}
  function* {U32}
  argument {Function_Argument} (function)
  functions {Function_Argument...} (argument)
  result {Instruction} (Call_Word, Empty_String, functions)

# Leave the block when local 0 is below a number.
# Example: 48 gives "get 0", "push 48", "less", "break_if 0".
Below_Code {}
  low* {U32}
  get {Number_Instruction} (Get, Zero)
  push {Number_Instruction} (Push_Word, low)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (get, push, less, leave)

# Leave the block when local 0 is above a number.
# Example: 57 gives "push 57", "get 0", "less", "break_if 0".
Above_Code {}
  high* {U32}
  push {Number_Instruction} (Push_Word, high)
  get {Number_Instruction} (Get, Zero)
  less {Bare_Instruction} (Less)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (push, get, less, leave)

# Keep local 0 as the one field of the record at its place, and give the place.
# Example: 16 gives "push 16", "get 0", "store", "push 16", "return".
Hold_Code {}
  place* {U32}
  push {Number_Instruction} (Push_Word, place)
  get {Number_Instruction} (Get, Zero)
  store {Bare_Instruction} (Store)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (push, get, store, push, give)

# Give a number from the function: "push 0", "return".
Give_Code {}
  number* {U32}
  push {Number_Instruction} (Push_Word, number)
  give {Bare_Instruction} (Return_Word)
  result {Instruction...} (push, give)

# Kernel code that reads one character from low to high. It gives the place of the record that
# holds the character, or 0 when the character is outside the range.
# Example: 48 and 57 give the code that reads one digit.
Range_Code {}
  low* {U32}
  high* {U32}
  take {Bare_Instruction} (Read)
  keep {Number_Instruction} (Set, Zero)
  open {Bare_Instruction} (Block)
  below {Below_Code} (low)
  above {Above_Code} (high)
  hold {Hold_Code} (Record_Place)
  close {Bare_Instruction} (End)
  refuse {Give_Code} (Zero)
  result {Instruction...} (take, keep, open, below..., above..., hold..., close, refuse...)

# Leave the block when local 0 holds a number: "get 0", "push 0", "equal", "break_if 0".
Refused_Check {}
  number* {U32}
  get {Number_Instruction} (Get, Zero)
  push {Number_Instruction} (Push_Word, number)
  equal {Bare_Instruction} (Equal)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (get, push, equal, leave)

# Leave the block unless no byte is left: "read", "push 4294967295", "equal", "push 0",
# "equal", "break_if 0".
End_Check {}
  end_value* {U32}
  take {Bare_Instruction} (Read)
  push {Number_Instruction} (Push_Word, end_value)
  equal {Bare_Instruction} (Equal)
  push_zero {Number_Instruction} (Push_Word, Zero)
  leave {Number_Instruction} (Break_If, Zero)
  result {Instruction...} (take, push, equal, push_zero, equal, leave)

# Write the one field of the record at local 0, and give 0: "get 0", "load", "write", "push 0",
# "return".
Write_Code {}
  number* {U32}
  get {Number_Instruction} (Get, Zero)
  load {Bare_Instruction} (Load)
  write {Bare_Instruction} (Write)
  give {Give_Code} (number)
  result {Instruction...} (get, load, write, give...)

# Main for a reader: read the whole input as one record. Main writes its field and gives 0, or
# gives 1 when the input is refused, or when bytes are left after the record.
# Example: "7" writes "7" and gives 0; "x" gives 1.
Reading_Main {}
  reader* {U32}
  call {Call_Instruction} (reader)
  keep {Number_Instruction} (Set, Zero)
  open {Bare_Instruction} (Block)
  refused {Refused_Check} (Zero)
  whole {End_Check} (End_Of_Input)
  write {Write_Code} (Zero)
  close {Bare_Instruction} (End)
  refuse {Give_Code} (One)
  result {Instruction...} (call, keep, open, refused..., whole..., write..., close, refuse...)

# A program that reads its input with the reader's code, function 1.
Reading_Program {}
  code* {Instruction...} count: 1..
  main_code {Reading_Main} (Reader_Number)
  main_head {Function_Head} (Main_Number, Main_Name, No_Inputs)
  main {Function} (main_head, main_code)
  reader_head {Function_Head} (Reader_Number, Reader_Name, No_Inputs)
  reader {Function} (reader_head, code)
  functions {Function...} (main, reader)
  result {Program} (functions)

# A printable character's number.
# Example: "0" gives 48.
Character_Code {}
  character* {Line_Character}
  result {Integer} (character)
    {32..126} (" ".."~")

# The number of the one character in quotes.
# Example: '"0"' gives 48.
Quoted_Code {}
  quoted* {String_Literal}
  characters {String_Character...} (quoted.characters)
  one_character {Needs} (characters.count = 1)
  character {String_Character} (characters.first)
  code {Character_Code} (character)
  result {Integer} (code)

# The code that reads a character of a range.
# Example: '"0".."9"' gives the code that reads one digit.
Range_Reader {}
  range* {Character_Range}
  low {Quoted_Code} (range.low)
  high {Quoted_Code} (range.high)
  code {Range_Code} (low, high)
  result {Reading_Program} (code)

# The code that reads a union line's one character range.
Box_Reader {}
  box* {Union_Box}
  result {Range_Reader} (box.items)

# A type of one character range as a program that reads it from its input.
# Example: 'Digit {"0".."9"}' gives a program that reads one digit, writes it and gives 0.
Compiled_Range {}
  line {Union_Line}
  reader {Box_Reader} (line.base)
  text {Text}
    1. {line}
