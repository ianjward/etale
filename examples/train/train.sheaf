# A train journey: one or more trains, each with its stops.
# Check:  node bin/sheaf.mjs check examples/train/train.sheaf
# Run:    node bin/sheaf.mjs run examples/train/train.sheaf Journey examples/train/journey.txt

Hour {Integer} value: 0..23              # a conversion layout
  1. {Digit} qty: 2
Minute {Integer} value: 0..59
  1. {Digit} qty: 2

Time {}                                  # "08:45"
  hour {Hour}
  minute {Minute}
  hour_minutes {Integer} calc: hour * 60
  minutes {Integer} calc: hour_minutes + minute
  text {Text}
    1. {hour}
    2. {":"}
    3. {minute}

# A station name is a Word (letters, from the standard library) and
# at most 12 characters: one text read as both types.
Short {Character} qty: 1..12
Station_Name {Word & Short}

Line_Code {Text}                         # "R10"
  1. {"R"}
  2. {Digit} qty: 1..2

Kind {"fast" | "slow"}
Status {"on time" | "late" | "very late"}
Late_Stop_Credit {25}                    # credit for each late stop, used by name

Stop {}                                  # "Drammen 09:20 +4"
  station {Station_Name} unique: True
  due {Time}
  delay {Integer} value: 0..120
  arrives {Integer} calc: due.minutes + delay, mod: 1440
  status {Status} from: delay
    {"on time"} if: delay = 0..1
    {"late"} if: delay = 2..9
    {"very late"} if: delay >= 10
  # a rule that reaches the Train around this stop
  plausible {True} if: delay <= Train.max_delay | status = "on time"
  text {Text}
    1. {station}
    2. {" "}
    3. {due}
    4. {" +"}
    5. {delay}
    6. {Newline}

Late_Stop {Stop} if: delay >= 2

Train {}
  line {Line_Code}
  kind {Kind}
  max_delay {Integer} value: 10 | 30 | 60
  stops {Stop} qty: 1..
  late_stops {Integer} count: stops, filter: Late_Stop
  total_delay {Integer} sum: stops.delay
  credit {Integer} calc: Late_Stop_Credit * late_stops
  refund {True | False} from: kind & late_stops
    {True} if: kind = "fast" & late_stops >= 1
    {False} if: kind = "fast" & late_stops = 0
    {False} if: kind = "slow"
  text {Text}
    1. {line}
    2. {" "}
    3. {kind}
    4. {" "}
    5. {max_delay}
    6. {Newline}
    7. {stops}

Journey {}                               # a record that holds itself
  train {Train}
  next_leg {Journey} qty: 0..1
  delay {Integer} calc: train.total_delay + next_leg.delay
  never_early {Claim} if: delay >= 0
