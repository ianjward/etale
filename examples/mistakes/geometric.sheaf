# Each declaration below falls outside geometric logic or would let the
# prover claim something false; `check` explains each (docs/geometric.md).

# A modulus that may be zero or negative ('mod: m', 'mod: -3') no longer reads:
# mod: takes a number written out in digits.

# 1. A claim about wrapped arithmetic. 'later' is not 'hour + 5': at hour 20
#    it is 1. The prover bounds a wrapped field by [0, m) and cannot prove it.
Clock {}
  hour {Integer} value: 0..23
  later {Integer} calc: hour + 5, mod: 24
  ahead {Claim} if: later >= hour
