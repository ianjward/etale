# Every declaration below breaks one rule of the spec; `check` explains each.

# 1. A type used before it is declared.
Early {Later}
Later {"x"}

# 2. A reserved word as a field name.
Bad_Name {}
  count {Integer}

# 3. A field that names a field below it.
Wrong_Order {}
  a (b + 1) {Integer}
  b {Integer}

# 4. A list used outside a fold.
Basket {}
  items {Digit 0..}
  first (items) {Integer}

# 5. A mapping that misses a combination and overlaps.
Grade {}
  score {Integer} value = 0..100
  pass (score) {Fact}
    {True} if score >= 50
    {False} if score < 40
    {False} if score = 45..49
    {True} if score = 49..60

# 6. A claim the ranges cannot settle.
Pair {}
  a {Integer} value = 0..10
  b {Integer} value = 5..20
  diff (b - a) {Integer}
  positive {Claim} diff > 0

# 7. A product of two reads through a recursive field.
Tower {}
  h {Integer} value = 1..9
  rest {Tower 0..1}
  blowup (rest.h * rest.h) {Integer}

# 8. Rounding would be needed.
Price {}
  amount {Decimal} places = 2
  tax (amount * 0.075) {Decimal} places = 2

# 9. A broken cost promise.
Pairs {}
  xs {Digit 0..}
  n (xs.count) {Integer} cost <= 1

# 10. Arithmetic on text.
Label {}
  code {"5"}
  twice (code * 2) {Integer}

# 11. Reaching a record that is not around.
Note {}
  text {"n"}
  filled {True} Basket.items.count >= 1

# 12. A claim of two comparisons. A claim is one comparison; give each its own field.
Window_Claim {}
  low {Integer} value = 0..9
  high {Integer} value = 10..19
  ordered {Claim} low < high & high <= 19
