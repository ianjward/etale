# Every declaration below breaks one rule of the spec; `check` explains each.

# 1. A type used before it is declared.
Early {Later...} count: 2
Later {"x"}

# 2. A reserved word as a field name.
Bad_Name {}
  value {Integer}

# 3. A field that names a field below it.
Wrong_Order {}
  a {Integer} (b + 1)
  b {Integer}

# 4. A list compared as one value.
Basket {}
  items {Digit...}
  has_four {Needs} (items = "4")

# 5. A mapping that misses a combination and overlaps.
Grade {}
  score {Integer} (0..100)
  pass {True | False} (score)
    {True} (>= 50)
    {False} (< 40)
    {False} (45..49)
    {True} (49..60)

# 6. A claim the ranges cannot settle.
Pair {}
  a {Integer} (0..10)
  b {Integer} (5..20)
  diff {Integer} (b - a)
  positive {Claims} (diff > 0)

# 7. A product of two reads through a recursive field.
Tower {}
  h {Integer} (1..9)
  rest {Tower} count: 0..1
  blowup {Integer} (rest.h * rest.h)

# 8. Rounding would be needed, and no round: is given.
Tax_Rate {Decimal} (0.075)

Price {}
  amount {Decimal} places: 2
  tax {Decimal} (amount * Tax_Rate) places: 2

# 9. Arithmetic on text.
Two {Integer} (2)

Label {}
  code {Digit}
  twice {Integer} (code * Two)

# 10. Reaching a record that is not around.
Note {}
  words {Line_Text}
  items_in {Integer} (Basket.items)
  filled {Needs} (items_in >= 1)
