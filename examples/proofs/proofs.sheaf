# Claims: facts the checker proves for every value, by one fixed method.

# The window always has width at least 10, whatever the stored values are,
# because their ranges do not overlap.
Window {}
  start {Integer} value: 0..10
  finish {Integer} value: 20..30
  width {Integer} value: finish - start
  wide_enough {Claims} width >= 10
  text {Text}
    1. {start}
    2. {".."}
    3. {finish}

# A chain of digits written "+3+4+5". Its total is never negative:
# proved by induction, assuming the claim for the rest of the chain.
Chain {}
  x {Integer} value: 0..9
  rest {Chain} qty: 0..1
  total {Integer} value: x + rest.total
  rest_count {Integer} count: rest
  links {Integer} value: rest_count + rest.links
  nonnegative {Claims} total >= 0
  text {Text}
    1. {"+"}
    2. {x}
    3. {rest}

# A two-input mapping: a table over a numeric range and a finite set.
Zone {"A" | "B"}
Tier {"light" | "heavy" | "far"}

Parcel {}
  weight {Integer} value: 0..50
  zone {Zone}
  tier {Tier} (weight, zone)
    {"light"} if: weight = 0..5 & zone = "A"
    {"heavy"} if: weight = 6..50 & zone = "A"
    {"far"} if: zone = "B"
  text {Text}
    1. {weight}
    2. {" "}
    3. {zone}
