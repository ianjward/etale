# Orders that belong to customers. A relation between the items of two lists is stated in
# the record that holds both: every order's customer is the code of one customer in the
# book, and 'unique: True' on the code makes it one.
Customer_Code {Text}
  1. {"C"}
  2. {Digit} qty: 3

Customer {}
  code {Customer_Code} unique: True
  name {Line_Text}
  text {Text}
    1. {code}
    2. {" "}
    3. {name}
    4. {Newline}

Order {}
  number {Natural}
  customer {Customer_Code}
  text {Text}
    1. {number}
    2. {" "}
    3. {customer}
    4. {Newline}

Book {}
  customers {Customer} qty: 1..
  orders {Order} qty: 1..
  each_order_has_its_customer {Needs} orders.customer = customers.code
  text {Text}
    1. {customers}
    2. {"---"}
    3. {Newline}
    4. {orders}
