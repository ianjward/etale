# Orders that belong to customers. A path that starts with a type name
# reaches the nearest record of that type around this one: inside an
# Order, 'Order.customer' is that order's customer, and 'Book.customers'
# the customers of the book holding it. So "this order belongs to that
# customer" is a filter, and "there is one" is a count.
Customer_Code {Text}
  1. {"C"}
  2. {Digit} qty: 3

Customer {}
  code {Customer_Code} unique: True
  name {Line_Text}
  text {Text}
    1. {code}
    2. {" "}
    3. {name}
    4. {Newline}

Its_Customer {Customer} if: code = Order.customer

Order {}
  number {Natural}
  customer {Customer_Code}
  matches {Integer} count: Book.customers, filter: Its_Customer
  known {True} if: matches = 1
  text {Text}
    1. {number}
    2. {" "}
    3. {customer}
    4. {Newline}

Book {}
  customers {Customer} qty: 1..
  orders {Order} qty: 1..
  text {Text}
    1. {customers}
    2. {"---"}
    3. {Newline}
    4. {orders}
