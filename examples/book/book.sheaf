# Orders that belong to customers. A relation between the items of two lists is stated in
# the record that holds both: every order's customer is the code of one customer in the
# book, and 'unique: code' on the customers list makes it one.
Customer_Code {Text}
  1. {"C"}
  2. {Digit...} count: 3

Customer {}
  code {Customer_Code}
  name {Line_Text}
  text {Text}
    1. {code}
    2. {" "}
    3. {name}
    4. {Newline}

Order {}
  number {Natural}
  customer {Customer_Code}
  text {Text}
    1. {number}
    2. {" "}
    3. {customer}
    4. {Newline}

Book {}
  customers {Customer...} count: 1.., unique: code
  orders {Order...} count: 1..
  each_order_has_its_customer {Needs} (orders.customer in customers.code)
  text {Text}
    1. {customers}
    2. {"---"}
    3. {Newline}
    4. {orders}
