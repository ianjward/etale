# Orders: stored and computed fields, folds, a mapping, a rule and a filter.
# Check:  node bin/sheaf.mjs check examples/orders/orders.sheaf
# Run:    node bin/sheaf.mjs run examples/orders/orders.sheaf Order examples/orders/order_1042.txt

# A stock-keeping unit: three capital letters, a dash, four digits.
Sku {Text}
  1. {Uppercase} qty: 3
  2. {"-"}
  3. {Digit} qty: 4

# One order line, e.g. "ABC-0001 x3 @ 19.99".
Line {}
  sku {Sku}
  units {Integer} value: 1..1000
  price {Decimal} places: 2, value: 0.00..
  line_total {Decimal} value: units * price, places: 2
  big {True | False} from: line_total
    {True} if: line_total >= 500.00
    {False} if: line_total < 500.00
  text {Text}
    1. {sku}
    2. {" x"}
    3. {units}
    4. {" @ "}
    5. {price}
    6. {Newline}

# A line worth 500.00 or more. Used below as a filter on a list.
Big_Line {Line} if: line_total >= 500.00

# An order: a header line, then one or more lines.
Order {}
  number {Natural}
  lines {Line} qty: 1..
  total {Decimal} sum: lines.line_total
  big_lines {Integer} count: lines, filter: Big_Line
  big_total {Decimal} sum: lines.line_total, filter: Big_Line, places: 2
  line_count {Integer} count: lines
  not_all_big {True} if: big_lines <= line_count
  text {Text}
    1. {"order "}
    2. {number}
    3. {Newline}
    4. {lines}

# A refinement of a record is a filter, here on whole orders.
Big_Order {Order} if: total >= 1000.00
