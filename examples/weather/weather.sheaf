# Every pattern of the language in one small file: a weather log.
# A Log text: "ST1 -5 TRUE 07 2.5\n-3 snow\n12 sun\n+1+2"

Code {Text}                              # a layout: numbered positions
  1. {Uppercase 2}
  2. {Digit}

Short {Character 0..4}
Short_Code {Code & Short}                # both, over the same characters

Degrees {Integer} value = -60..60        # a conversion layout
  1. {"-" 0..1}
  2. {Digit 1..2}

Sky {"sun" | "rain" | "snow"}
Spaces {" " 1..} print = 1

Reading {}
  degrees {Degrees} unique
  s1 {Spaces}
  sky {Sky}
  nl {"\n"}
  # a mapping on one input; a rule that reaches the Log around it
  cold (degrees) {Fact}
    {True} if degrees <= 0
    {False} if degrees > 0
  plausible {True} degrees >= Log.floor
  snow_is_cold {True} sky = "sun" | "rain" | degrees <= 2

Cold_Reading {Reading} cold = True

Tally {}                                 # a record that holds itself
  plus {"+"}
  x {Integer} value = 0..9
  rest {Tally 0..1}
  total (x + rest.total) {Integer}
  nonnegative {Claim} total >= 0

Log {}
  station {Short_Code}
  s1 {Spaces}
  floor {Integer} value = ..0
  s2 {Spaces}
  alarm {Fact}
  s3 {Spaces}
  hour {Integer} value = 0 | 6..23
  s4 {Spaces}
  rain {Decimal} places = 1 & value = 0.0..
  nl {Newline}
  readings {Reading 1..}
  tally {Tally}
  colds (readings.Cold_Reading.count) {Integer} value = 0.. & cost <= readings.count
  limit (5) {Integer}
  room (limit - colds) {Integer}
  later (hour + 5) {Integer} modulo = 24
  warn (alarm & colds) {True | False}
    {True} if alarm = True & colds >= 1
    {False} if alarm = True & colds = 0
    {False} if alarm = False
