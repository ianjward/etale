# A temperature in whole degrees, like "-12" or "31".
Temperature {Integer} value: -90..60
  1. {"-"} qty: 0..1                          # a "-" position makes the number negative
  2. {Digit} qty: 1..2

Reading {}
  where {Lowercase} qty: 1..
  degrees {Temperature}
  freezing {Fact} from: degrees
    {True} if: degrees <= 0
    {False} if: degrees > 0
  text {Text}
    1. {where}
    2. {" "}
    3. {degrees}
