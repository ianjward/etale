Bit: 0 | 1

Xor:
  left*: Bit
  right*: Bit

  out: Bit
    0:
      left is 0
      right is 0
    1:
      left is 0
      right is 1
    1:
      left is 1
      right is 0
    0:
      left is 1
      right is 1

Xor_Associativity:
  a: Bit
  b: Bit
  c: Bit
  ab: Xor(left: a, right: b)
  ab_c: Xor(left: ab.out, right: c)
  bc: Xor(left: b, right: c)
  a_bc: Xor(left: a, right: bc.out)

  claim ab_c.out is a_bc.out
