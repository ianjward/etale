# Calendar dates, "2026-10-15", valid in the Gregorian calendar.
# Every step is a checked table; leap years use 'mod' arithmetic.

Year {Integer}
  1. {Digit} qty: 4

Month {Integer} value: 1..12
  1. {Digit} qty: 2

Day_Of_Month {Integer} value: 1..31
  1. {Digit} qty: 2

Month_Length {"31" | "30" | "feb"}
Day_Fit {"yes" | "no" | "leap_day"}

Date {}
  year {Year}
  month {Month}
  day {Day_Of_Month}
  r4 {Integer} value: year * 1, mod: 4
  r100 {Integer} value: year * 1, mod: 100
  r400 {Integer} value: year * 1, mod: 400
  length {Month_Length} from: month
    {"31"} if: month = 1 | 3 | 5 | 7 | 8 | 10 | 12
    {"30"} if: month = 4 | 6 | 9 | 11
    {"feb"} if: month = 2
  fit {Day_Fit} from: length & day
    {"yes"} if: length = "31"
    {"yes"} if: length = "30" & day = 1..30
    {"no"} if: length = "30" & day = 31
    {"yes"} if: length = "feb" & day = 1..28
    {"leap_day"} if: length = "feb" & day = 29
    {"no"} if: length = "feb" & day = 30..31
  by_four {True | False} from: r4 & r100
    {True} if: r4 = 0 & r100 = 1..99
    {False} if: r4 = 0 & r100 = 0
    {False} if: r4 = 1..3
  leap {True | False} from: by_four & r400
    {True} if: by_four = True
    {True} if: by_four = False & r400 = 0
    {False} if: by_four = False & r400 = 1..399
  valid {True | False} from: fit & leap
    {True} if: fit = "yes"
    {False} if: fit = "no"
    {True} if: fit = "leap_day" & leap = True
    {False} if: fit = "leap_day" & leap = False
  real_date {True} if: valid = True
  text {Text}
    1. {year}
    2. {"-"}
    3. {month}
    4. {"-"}
    5. {day}
