# Calendar dates, "2026-10-15", valid in the Gregorian calendar.
# Every step is a checked table; leap years use 'modulo' arithmetic.

Year {Integer}
  1. {Digit 4}

Month {Integer} value = 1..12
  1. {Digit 2}

Day_Of_Month {Integer} value = 1..31
  1. {Digit 2}

Month_Length {"31" | "30" | "feb"}
Day_Fit {"yes" | "no" | "leap_day"}

Date {}
  year {Year}
  dash1 {"-"}
  month {Month}
  dash2 {"-"}
  day {Day_Of_Month}
  r4 (year * 1) {Integer} modulo = 4 & value = 0..3
  r100 (year * 1) {Integer} modulo = 100 & value = 0..99
  r400 (year * 1) {Integer} modulo = 400 & value = 0..399
  length (month) {Month_Length}
    {"31"} if month = 1 | 3 | 5 | 7 | 8 | 10 | 12
    {"30"} if month = 4 | 6 | 9 | 11
    {"feb"} if month = 2
  fit (length & day) {Day_Fit}
    {"yes"} if length = "31"
    {"yes"} if length = "30" & day = 1..30
    {"no"} if length = "30" & day = 31
    {"yes"} if length = "feb" & day = 1..28
    {"leap_day"} if length = "feb" & day = 29
    {"no"} if length = "feb" & day = 30..31
  by_four (r4 & r100) {Fact}
    {True} if r4 = 0 & r100 = 1..99
    {False} if r4 = 0 & r100 = 0
    {False} if r4 = 1..3
  leap (by_four & r400) {Fact}
    {True} if by_four = True
    {True} if by_four = False & r400 = 0
    {False} if by_four = False & r400 = 1..399
  valid (fit & leap) {Fact}
    {True} if fit = "yes"
    {False} if fit = "no"
    {True} if fit = "leap_day" & leap = True
    {False} if fit = "leap_day" & leap = False
  real_date {True} valid = True
