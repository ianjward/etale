# Calendar dates, "2026-10-15", valid in the Gregorian calendar.
# Every step is a checked table; leap years use wrapped arithmetic.

Year {Integer} (0..9999)
Month {Integer} (1..12)
Day_Of_Month {Integer} (1..31)
Years_Per_Leap {Integer} (4)
Years_Per_Century {Integer} (100)
Years_Per_Cycle {Integer} (400)

Month_Length {"31" | "30" | "feb"}
Day_Fit {"yes" | "no" | "leap_day"}

Date {}
  year {Year}
  month {Month}
  day {Day_Of_Month}
  r4 {Integer} (year) wrap_at: Years_Per_Leap
  r100 {Integer} (year) wrap_at: Years_Per_Century
  r400 {Integer} (year) wrap_at: Years_Per_Cycle
  length {Month_Length} (month)
    {"31"} (1 | 3 | 5 | 7 | 8 | 10 | 12)
    {"30"} (4 | 6 | 9 | 11)
    {"feb"} (2)
  fit {Day_Fit} (length, day)
    {"yes"} (length = "31")
    {"yes"} (length = "30" & day in 1..30)
    {"no"} (length = "30" & day = 31)
    {"yes"} (length = "feb" & day in 1..28)
    {"leap_day"} (length = "feb" & day = 29)
    {"no"} (length = "feb" & day in 30..31)
  by_four {True | False} (r4, r100)
    {True} (r4 = 0 & r100 in 1..99)
    {False} (r4 = 0 & r100 = 0)
    {False} (r4 in 1..3)
  leap {True | False} (by_four, r400)
    {True} (by_four = True)
    {True} (by_four = False & r400 = 0)
    {False} (by_four = False & r400 in 1..399)
  valid {True | False} (fit, leap)
    {True} (fit = "yes")
    {False} (fit = "no")
    {True} (fit = "leap_day" & leap = True)
    {False} (fit = "leap_day" & leap = False)
  real_date {Needs} (valid = True)
  text {Text}
    1. {year} digits: 4
    2. {"-"}
    3. {month} digits: 2
    4. {"-"}
    5. {day} digits: 2
