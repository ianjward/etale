# Logic gates over Fact, each a checked truth table.
# (And_Gate is in language.sheaf itself, Step 8.)

Not_Gate {}
  x {Fact}
  out {Fact} from: x
    {False} if: x = True
    {True} if: x = False

Or_Gate {}
  left {Fact}
  right {Fact}
  out {Fact} from: left & right
    {True} if: left = True
    {True} if: left = False & right = True
    {False} if: left = False & right = False

Xor_Gate {}
  left {Fact}
  right {Fact}
  out {Fact} from: left & right
    {False} if: left = True & right = True
    {True} if: left = True & right = False
    {True} if: left = False & right = True
    {False} if: left = False & right = False

Implies_Gate {}
  left {Fact}
  right {Fact}
  out {Fact} from: left & right
    {True} if: left = False
    {True} if: left = True & right = True
    {False} if: left = True & right = False
