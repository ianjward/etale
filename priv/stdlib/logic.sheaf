# Logic gates over TRUE and FALSE, each a checked truth table.
# (And_Gate is in language.sheaf itself, Step 8.)

Not_Gate {}
  x {True | False}
  out {True | False} (x)
    {False} (True)
    {True} (False)

Or_Gate {}
  left {True | False}
  right {True | False}
  out {True | False} (left, right)
    {True} (left = True)
    {True} (left = False & right = True)
    {False} (left = False & right = False)

Xor_Gate {}
  left {True | False}
  right {True | False}
  out {True | False} (left, right)
    {False} (left = True & right = True)
    {True} (left = True & right = False)
    {True} (left = False & right = True)
    {False} (left = False & right = False)

Implies_Gate {}
  left {True | False}
  right {True | False}
  out {True | False} (left, right)
    {True} (left = False)
    {True} (left = True & right = True)
    {False} (left = True & right = False)
