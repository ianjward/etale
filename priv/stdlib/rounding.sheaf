# The language's own rounding rules, each a checked table (language.sheaf,
# Step 5). 'round:' picks one by its word, e.g.
#   share {Decimal} (total / Parts) round: 0.01
# rounds with Half_Even, 'round: 0.01 away' with Half_Up, 'round: 0.01 lower'
# with Half_Lower and 'round: 0.01 higher' with Half_Higher. No file names
# them. The checker gives the rule what was cut off, as a fraction of the last
# place kept (remainder), whether the last digit kept is odd (odd), and
# whether the exact value is below 0 (negative). When nothing was cut off,
# the value is kept as it is.

# Round half to even: a tie goes to the even neighbour.
Half_Even {}
  remainder {Decimal} (0..1)
  odd {True | False}
  direction {Direction} (remainder, odd)
    {"toward_zero"} (remainder < 0.5)
    {"away_from_zero"} (remainder > 0.5)
    {"toward_zero"} (remainder = 0.5 & odd = False)
    {"away_from_zero"} (remainder = 0.5 & odd = True)

# Round half up: a tie goes away from zero, so 2.5 is 3 and -2.5 is -3.
Half_Up {}
  remainder {Decimal} (0..1)
  direction {Direction} (remainder)
    {"toward_zero"} (< 0.5)
    {"away_from_zero"} (>= 0.5)

# Round half toward the lower number: 2.5 is 2 and -2.5 is -3.
Half_Lower {}
  remainder {Decimal} (0..1)
  negative {True | False}
  direction {Direction} (remainder, negative)
    {"toward_zero"} (remainder < 0.5)
    {"away_from_zero"} (remainder > 0.5)
    {"toward_zero"} (remainder = 0.5 & negative = False)
    {"away_from_zero"} (remainder = 0.5 & negative = True)

# Round half toward the higher number: 2.5 is 3 and -2.5 is -2.
Half_Higher {}
  remainder {Decimal} (0..1)
  negative {True | False}
  direction {Direction} (remainder, negative)
    {"toward_zero"} (remainder < 0.5)
    {"away_from_zero"} (remainder > 0.5)
    {"away_from_zero"} (remainder = 0.5 & negative = False)
    {"toward_zero"} (remainder = 0.5 & negative = True)

# Round down, toward the lower neighbour: 2.7 is 2 and -2.3 is -3.
Floor {}
  negative {True | False}
  direction {Direction} (negative)
    {"toward_zero"} (False)
    {"away_from_zero"} (True)

# Round up, toward the higher neighbour: 2.3 is 3 and -2.7 is -2.
Ceiling {}
  negative {True | False}
  direction {Direction} (negative)
    {"away_from_zero"} (False)
    {"toward_zero"} (True)
