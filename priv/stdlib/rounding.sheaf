# Rounding rules, each a checked table (language.sheaf, Step 5). A rule is
# named by round: beside a calculation, e.g.
#   share {Decimal} value: total / 3, places: 2, round: Half_Even
# The checker gives the rule what was cut off, as a fraction of the last
# place kept (remainder), whether the last digit kept is odd (odd), and
# whether the exact value is below 0 (negative). When nothing was cut off,
# the value is kept as it is.

# Round half to even: a tie goes to the even neighbour.
Half_Even {}
  remainder {Decimal} value: 0..1
  odd {True | False}
  direction {Direction} (remainder, odd)
    {"toward_zero"} if: remainder < 0.5
    {"away_from_zero"} if: remainder > 0.5
    {"toward_zero"} if: remainder = 0.5 & odd = False
    {"away_from_zero"} if: remainder = 0.5 & odd = True

# Round half up: a tie goes away from zero, so 2.5 is 3 and -2.5 is -3.
Half_Up {}
  remainder {Decimal} value: 0..1
  direction {Direction} (remainder)
    {"toward_zero"} if: remainder < 0.5
    {"away_from_zero"} if: remainder >= 0.5

# Round down, toward the lower neighbour: 2.7 is 2 and -2.3 is -3.
Floor {}
  negative {True | False}
  direction {Direction} (negative)
    {"toward_zero"} if: negative = False
    {"away_from_zero"} if: negative = True

# Round up, toward the higher neighbour: 2.3 is 3 and -2.7 is -2.
Ceiling {}
  negative {True | False}
  direction {Direction} (negative)
    {"away_from_zero"} if: negative = False
    {"toward_zero"} if: negative = True
