# Bits and bytes.

Binary_Digit {"0" | "1"}

# A bit as a number, 0 or 1.
Bit {Integer} value = 0..1
  1. {Binary_Digit}

# A byte written as eight bits, most significant first, e.g. "01000001" (65).
Byte {}
  b7 {Bit}
  b6 {Bit}
  b5 {Bit}
  b4 {Bit}
  b3 {Bit}
  b2 {Bit}
  b1 {Bit}
  b0 {Bit}
  w7 (b7 * 128) {Integer}
  w6 (b6 * 64) {Integer}
  w5 (b5 * 32) {Integer}
  w4 (b4 * 16) {Integer}
  w3 (b3 * 8) {Integer}
  w2 (b2 * 4) {Integer}
  w1 (b1 * 2) {Integer}
  number (w7 + w6 + w5 + w4 + w3 + w2 + w1 + b0) {Integer}
  at_least_zero {Claim} number >= 0
  fits_in_a_byte {Claim} number <= 255

# Exclusive or of two bits, as a checked table.
Xor_Bit {}
  a {Binary_Digit}
  b {Binary_Digit}
  out (a & b) {Binary_Digit}
    {"0"} if a = "0" & b = "0"
    {"1"} if a = "0" & b = "1"
    {"1"} if a = "1" & b = "0"
    {"0"} if a = "1" & b = "1"
