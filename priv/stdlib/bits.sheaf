# Bits and bytes.

Binary_Digit {"0" | "1"}

# A bit as a number, 0 or 1.
Bit {Integer} value: 0..1
  1. {Binary_Digit}

# A byte written as eight bits, most significant first, e.g. "01000001" (65).
Byte {}
  b7 {Bit}
  b6 {Bit}
  b5 {Bit}
  b4 {Bit}
  b3 {Bit}
  b2 {Bit}
  b1 {Bit}
  b0 {Bit}
  w7 {Integer} calc: b7 * 128
  w6 {Integer} calc: b6 * 64
  w5 {Integer} calc: b5 * 32
  w4 {Integer} calc: b4 * 16
  w3 {Integer} calc: b3 * 8
  w2 {Integer} calc: b2 * 4
  w1 {Integer} calc: b1 * 2
  number {Integer} calc: w7 + w6 + w5 + w4 + w3 + w2 + w1 + b0
  at_least_zero {Claim} if: number >= 0
  fits_in_a_byte {Claim} if: number <= 255

# Exclusive or of two bits, as a checked table.
Xor_Bit {}
  a {Binary_Digit}
  b {Binary_Digit}
  out {Binary_Digit} from: a & b
    {"0"} if: a = "0" & b = "0"
    {"1"} if: a = "0" & b = "1"
    {"1"} if: a = "1" & b = "0"
    {"0"} if: a = "1" & b = "1"
