# Bits and bytes.

Binary_Digit {"0" | "1"}

# A bit as a number, 0 or 1.
Bit {Integer} (0..1)

# The value of each place of a byte.
Place_7 {Integer} (128)
Place_6 {Integer} (64)
Place_5 {Integer} (32)
Place_4 {Integer} (16)
Place_3 {Integer} (8)
Place_2 {Integer} (4)
Place_1 {Integer} (2)

# A byte written as eight bits, most significant first, e.g. "01000001" (65).
Byte {}
  b7 {Bit}
  b6 {Bit}
  b5 {Bit}
  b4 {Bit}
  b3 {Bit}
  b2 {Bit}
  b1 {Bit}
  b0 {Bit}
  w7 {Integer} (b7 * Place_7)
  w6 {Integer} (b6 * Place_6)
  w5 {Integer} (b5 * Place_5)
  w4 {Integer} (b4 * Place_4)
  w3 {Integer} (b3 * Place_3)
  w2 {Integer} (b2 * Place_2)
  w1 {Integer} (b1 * Place_1)
  number {Integer} (w7 + w6 + w5 + w4 + w3 + w2 + w1 + b0)
  at_least_zero {Claims} (number >= 0)
  fits_in_a_byte {Claims} (number <= 255)

# Exclusive or of two bits, as a checked table.
Xor_Bit {}
  a {Binary_Digit}
  b {Binary_Digit}
  out {Binary_Digit} (a, b)
    {"0"} (a = "0" & b = "0")
    {"1"} (a = "0" & b = "1")
    {"1"} (a = "1" & b = "0")
    {"0"} (a = "1" & b = "1")
