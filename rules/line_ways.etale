In_Top_Line:
  at: Top_Line

  name: Last(at: at, after: "", class: "name", to: Top_Name)

In_Top_Name:
  at: Top_Name

  colon: Last(at: at, after: "", class: ":", to: Top_Colon)

In_Top_Colon:
  at: Top_Colon

  false: Way(at: at, after: "", class: "False", to: Member)
  true: Way(at: at, after: "False", class: "True", to: Member)
  end: Way(at: at, after: "True", class: "end", to: Ended)
  name: Way(at: at, after: "end", class: "name", to: Constant)
  value: Way(at: at, after: "name", class: "number", to: After_Number)
  quoted: Last(at: at, after: "number", class: "quoted", to: Member)

In_Constant:
  at: Constant

  times: Way(at: at, after: "", class: "*", to: Operator)
  plus: Way(at: at, after: "*", class: "+", to: Operator)
  minus: Way(at: at, after: "+", class: "-", to: Operator)
  divided: Way(at: at, after: "-", class: "/", to: Operator)
  bar: Last(at: at, after: "/", class: "|", to: Bar)

In_Item_Line:
  at: Item_Line

  claim: Way(at: at, after: "", class: "claim", to: Fact)
  block: Way(at: at, after: "claim", class: "impossible", to: Heading)
  name: Way(at: at, after: "impossible", class: "name", to: Item_Name)
  number: Way(at: at, after: "name", class: "number", to: Numbered)
  ordered: Way(at: at, after: "number", class: "ordered", to: Ordered)
  text: Last(at: at, after: "ordered", class: "text", to: Heading)

In_Item_Name:
  at: Item_Name

  star: Way(at: at, after: "", class: "*", to: Starred)
  colon: Last(at: at, after: "*", class: ":", to: Item_Colon)

In_Starred:
  at: Starred

  colon: Last(at: at, after: "", class: ":", to: Defining)
